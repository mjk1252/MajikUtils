<views:PanelWindow x:Class="Dock.App.Views.LaunchWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:views="clr-namespace:Dock.App.Views"
                   xmlns:panels="clr-namespace:Dock.App.Views.Panels"
                   Title="Dock Launcher"
                   Width="380" Height="560"
                   MinWidth="320" MinHeight="360"
                   WindowStyle="None"
                   AllowsTransparency="True"
                   ResizeMode="CanResize">
    <Border Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
                <TextBlock Text="Launcher" Foreground="#DDFFFFFF" FontSize="12" FontWeight="SemiBold"
                           Margin="18,12,0,0"/>
                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                           Foreground="#99FFFFFF" Cursor="Hand"
                           HorizontalAlignment="Right" Margin="0,12,18,0"
                           ToolTip="Put away"
                           MouseLeftButtonUp="OnMinimiseClick"/>
            </Grid>

            <panels:LauncherPanel x:Name="Launcher" Grid.Row="1"/>
        </Grid>
    </Border>
</views:PanelWindow>
