<Window x:Class="Dock.App.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Dock.App.Converters"
        Title="Dock"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        Drop="OnDrop"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        PreviewMouseLeftButtonDown="OnWindowPreviewMouseDown">
    <Window.Resources>
        <conv:PngBytesToImageSourceConverter x:Key="PngToImage"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:NameToInitialConverter x:Key="NameToInitial"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility"/>
        <conv:ScaleConverter x:Key="Scale"/>

        <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#EE1E1E1E"/>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="VerticalPanel">
            <StackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="TrayIconTemplate">
            <Border Width="34" Height="34" Margin="3,0"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnTrayIconClick"
                    MouseRightButtonUp="OnTrayIconRightClick">
                <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                       Width="20" Height="20"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Border x:Name="GlassBorder"
                CornerRadius="22"
                Padding="{Binding GlassPadding, RelativeSource={RelativeSource AncestorType=Window}}"
                Background="#14FFFFFF"
                BorderThickness="1"
                MouseMove="OnGlassMouseMove"
                MouseLeave="OnGlassMouseLeave"
                MouseRightButtonUp="OnGlassRightClick">
            <Border.BorderBrush>
                <LinearGradientBrush x:Name="RimBrush" StartPoint="0,0" EndPoint="1,0">
                    <GradientStop x:Name="RimStopLeft" Color="#20FFFFFF" Offset="0"/>
                    <GradientStop x:Name="RimStopMid" Color="#45FFFFFF" Offset="0.5"/>
                    <GradientStop x:Name="RimStopRight" Color="#20FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>
                <StackPanel x:Name="ContentStack" Orientation="Horizontal">
                    <StackPanel x:Name="SystemStatsWidget" Margin="8,0" VerticalAlignment="Center"
                                ToolTip="CPU / GPU usage">
                        <TextBlock Text="{Binding CpuPercent, StringFormat='C {0:0}%'}"
                                   FontSize="9" FontWeight="SemiBold" Foreground="#CCFFFFFF"/>
                        <TextBlock Text="{Binding GpuPercent, StringFormat='G {0:0}%'}"
                                   FontSize="9" FontWeight="SemiBold" Foreground="#CCFFFFFF"/>
                    </StackPanel>

                    <Border x:Name="SeparatorStats" Width="1" Margin="6,10" Background="#40FFFFFF"/>

                    <ItemsControl x:Name="PinnedItemsControl" ItemsSource="{Binding Items}" ItemsPanel="{StaticResource HorizontalPanel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Fixed-size, non-transformed hit region: hover/click logic lives here so the
                                     scale/bounce animation on the inner border (which visually grows past its
                                     own bounds) can never shift what the cursor is considered to be over. -->
                                <Border Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="{Binding ItemSpacing, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Cursor="Hand"
                                        ToolTip="{Binding Name}"
                                        MouseLeftButtonUp="OnItemClick"
                                        MouseRightButtonUp="OnItemRightClick"
                                        MouseEnter="OnItemMouseEnter"
                                        MouseLeave="OnItemMouseLeave">
                                    <!-- RenderTransform declared inline (not via a shared Style setter) so each
                                         generated icon gets its own mutable TransformGroup/ScaleTransform instance:
                                         a Style setter's value is one frozen, shared object across every user of the
                                         style, which both throws on direct property writes and would make every
                                         icon magnify in lockstep instead of independently. -->
                                    <Border RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                <TranslateTransform Y="0"/>
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Border CornerRadius="10" Background="#4D000000"
                                                    Visibility="{Binding IconPng, Converter={StaticResource NullToVisibility}}">
                                                <TextBlock Text="{Binding Name, Converter={StaticResource NameToInitial}}"
                                                           FontSize="20" FontWeight="SemiBold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                                                   Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Scale}, ConverterParameter=40}"
                                                   Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Scale}, ConverterParameter=40}"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Ellipse Width="5" Height="5" Fill="White"
                                                     VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                     Margin="0,0,0,2"
                                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="Separator1" Width="1" Margin="6,10" Background="#40FFFFFF"/>

                    <!-- Quick tools: launcher/recent/clipboard/shelf as a compact 2x2 grid instead
                         of a wide horizontal row. -->
                    <UniformGrid x:Name="QuickToolsGrid" Rows="2" Columns="2" Margin="0,0,4,0"
                                 Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Scale}, ConverterParameter=88}"
                                 Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Scale}, ConverterParameter=52}">
                        <Border x:Name="LauncherButton"
                                Margin="1"
                                Cursor="Hand"
                                ToolTip="Search and launch apps"
                                PreviewMouseLeftButtonDown="OnLauncherButtonPreviewDown"
                                MouseLeftButtonUp="OnLauncherButtonClick">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border x:Name="RecentButton"
                                Margin="1"
                                Cursor="Hand"
                                ToolTip="Recent files"
                                PreviewMouseLeftButtonDown="OnRecentButtonPreviewDown"
                                MouseLeftButtonUp="OnRecentButtonClick">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border x:Name="ClipboardButton"
                                Margin="1"
                                Cursor="Hand"
                                ToolTip="Clipboard history (Ctrl+Alt+Shift+V)"
                                PreviewMouseLeftButtonDown="OnClipboardButtonPreviewDown"
                                MouseLeftButtonUp="OnClipboardButtonClick">
                            <Grid>
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Ellipse Width="5" Height="5" Fill="#4FC3F7"
                                         VerticalAlignment="Top" HorizontalAlignment="Right"
                                         Margin="0,1,1,0"
                                         Visibility="{Binding ClipboardHistory.Count, Converter={StaticResource CountToVisibility}}"/>
                            </Grid>
                        </Border>

                        <Border x:Name="ShelfButton"
                                Margin="1"
                                Cursor="Hand"
                                ToolTip="Drop shelf -- drag files here to hold them temporarily"
                                AllowDrop="True"
                                PreviewMouseLeftButtonDown="OnShelfButtonPreviewDown"
                                MouseLeftButtonUp="OnShelfButtonClick"
                                Drop="OnShelfDrop">
                            <Grid>
                                <TextBlock Text="&#x25A4;" FontSize="14"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Ellipse Width="5" Height="5" Fill="#4FC3F7"
                                         VerticalAlignment="Top" HorizontalAlignment="Right"
                                         Margin="0,1,1,0"
                                         Visibility="{Binding ShelfItems.Count, Converter={StaticResource CountToVisibility}}"/>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <Border x:Name="SeparatorStacks" Width="1" Margin="6,10" Background="#40FFFFFF"
                            Visibility="{Binding Stacks.Count, Converter={StaticResource CountToVisibility}}"/>

                    <ItemsControl x:Name="StacksItemsControl" ItemsSource="{Binding Stacks}" ItemsPanel="{StaticResource HorizontalPanel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="{Binding ItemSpacing, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Cursor="Hand"
                                        ToolTip="{Binding Name}"
                                        PreviewMouseLeftButtonDown="OnStackItemPreviewDown"
                                        MouseLeftButtonUp="OnStackItemClick"
                                        MouseRightButtonUp="OnStackItemRightClick">
                                    <Border RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                <TranslateTransform Y="0"/>
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Border CornerRadius="10" Background="#4D000000"
                                                    Visibility="{Binding IconPng, Converter={StaticResource NullToVisibility}}">
                                                <TextBlock Text="{Binding Name, Converter={StaticResource NameToInitial}}"
                                                           FontSize="20" FontWeight="SemiBold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                                                   Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Scale}, ConverterParameter=40}"
                                                   Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Scale}, ConverterParameter=40}"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <!-- Small corner mark distinguishing a live folder stack from a plain pinned app. -->
                                            <Border Width="8" Height="8" CornerRadius="2" Background="#4FC3F7"
                                                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                    Margin="0,0,2,2"/>
                                        </Grid>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="Separator2" Width="1" Margin="6,10" Background="#40FFFFFF"
                            Visibility="{Binding HasTrayIcons, Converter={StaticResource BoolToVisibility}}"/>

                    <Border x:Name="OverflowChevron"
                            Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Scale}, ConverterParameter=24}"
                            Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Scale}, ConverterParameter=34}"
                            Margin="0,0,2,0"
                            Cursor="Hand"
                            ToolTip="More tray icons"
                            PreviewMouseLeftButtonDown="OnOverflowChevronPreviewDown"
                            MouseLeftButtonUp="OnOverflowChevronClick"
                            Visibility="{Binding HasTrayIcons, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="^" FontSize="14" Foreground="#CCFFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border x:Name="Separator3" Width="1" Margin="6,10" Background="#40FFFFFF"/>

                    <Border x:Name="ClockWidget"
                            Padding="12,0" Margin="2,0"
                            Cursor="Hand"
                            PreviewMouseLeftButtonDown="OnClockWidgetPreviewDown"
                            MouseLeftButtonUp="OnClockClick">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ClockTimeText" FontSize="15" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ClockDateText" FontSize="10"
                                       Foreground="#CCFFFFFF" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Liquid-glass top highlight: a soft sheen across the upper portion, non-interactive. -->
                <Border CornerRadius="22,22,0,0" IsHitTestVisible="False" VerticalAlignment="Top" Height="20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#20FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Subtle inner shadow along the bottom edge for a sense of glass thickness. -->
                <Border CornerRadius="0,0,22,22" IsHitTestVisible="False" VerticalAlignment="Bottom" Height="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#22000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Drag the dock's top edge to resize every icon (and the pill itself) at once. -->
                <Thumb x:Name="ResizeHandle" Height="8" VerticalAlignment="Top" Cursor="SizeNS"
                       DragDelta="OnResizeHandleDragDelta" DragCompleted="OnResizeHandleDragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>

        <Popup x:Name="ClockFlyout"
               Placement="Top"
               VerticalOffset="-10"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border CornerRadius="20" Background="{DynamicResource FlyoutBackgroundBrush}" Padding="24,20"
                    BorderBrush="#40FFFFFF" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="FlyoutTimeText" FontSize="42" FontWeight="Light"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FlyoutDateText" FontSize="14"
                               Foreground="#CCFFFFFF" HorizontalAlignment="Center" Margin="0,2,0,14"/>
                    <Calendar x:Name="FlyoutCalendar" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="OverflowFlyout"
               Placement="Top"
               VerticalOffset="-10"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border CornerRadius="18" Background="{DynamicResource FlyoutBackgroundBrush}" Padding="10"
                    BorderBrush="#40FFFFFF" BorderThickness="1">
                <ItemsControl ItemsSource="{Binding OverflowTrayIcons}"
                              ItemsPanel="{StaticResource HorizontalPanel}"
                              ItemTemplate="{StaticResource TrayIconTemplate}"/>
            </Border>
        </Popup>

        <Popup x:Name="LauncherFlyout"
               Placement="Top"
               VerticalOffset="-10"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border CornerRadius="20" Background="{DynamicResource FlyoutBackgroundBrush}" Padding="16"
                    BorderBrush="#40FFFFFF" BorderThickness="1" Width="340">
                <StackPanel>
                    <TextBox x:Name="LauncherSearchBox"
                             Height="34" FontSize="14" Padding="8,6"
                             Background="#20FFFFFF" Foreground="White" BorderThickness="0"
                             CaretBrush="White"
                             TextChanged="OnLauncherSearchChanged"/>

                    <TextBlock Text="INSTALLED" Foreground="#77FFFFFF" FontSize="10" FontWeight="SemiBold"
                               Margin="4,12,0,4"/>
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LauncherResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,6" Cursor="Hand" MouseLeftButtonUp="OnLauncherItemClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                                                   Width="22" Height="22" Margin="0,0,10,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Visibility="{Binding WingetResults.Count, Converter={StaticResource CountToVisibility}}">
                        <TextBlock Text="GET FROM WINGET" Foreground="#77FFFFFF" FontSize="10" FontWeight="SemiBold"
                                   Margin="4,14,0,4"/>
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding WingetResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="White"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Content="Install" Command="{Binding InstallCommand}"
                                                    Padding="10,3" FontSize="11" Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <TextBlock Text="Searching winget..." Foreground="#77FFFFFF" FontSize="11"
                               Margin="4,10,0,0"
                               Visibility="{Binding IsWingetSearching, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="RecentFlyout"
               Placement="Top"
               VerticalOffset="-10"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border CornerRadius="18" Background="{DynamicResource FlyoutBackgroundBrush}" Padding="14"
                    BorderBrush="#40FFFFFF" BorderThickness="1" Width="300">
                <StackPanel>
                    <TextBlock Text="RECENT FILES" Foreground="#77FFFFFF" FontSize="10" FontWeight="SemiBold"
                               Margin="4,0,0,8"/>
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,6" Cursor="Hand"
                                            MouseLeftButtonDown="OnFileDragMouseDown"
                                            MouseLeftButtonUp="OnRecentFileClick"
                                            MouseMove="OnRecentFileMouseMove">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                                                   Width="20" Height="20" Margin="0,0,10,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="ClipboardFlyout"
               Placement="Top"
               VerticalOffset="-10"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border CornerRadius="18" Background="{DynamicResource FlyoutBackgroundBrush}" Padding="14"
                    BorderBrush="#40FFFFFF" BorderThickness="1" Width="300">
                <StackPanel>
                    <Grid Margin="4,0,0,8">
                        <TextBlock Text="CLIPBOARD HISTORY" Foreground="#77FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="Clear" Foreground="#99FFFFFF" FontSize="10"
                                   HorizontalAlignment="Right" Cursor="Hand"
                                   MouseLeftButtonUp="OnClipboardClearClick"
                                   Visibility="{Binding ClipboardHistory.Count, Converter={StaticResource CountToVisibility}}"/>
                    </Grid>
                    <TextBlock Text="Nothing copied yet -- press Ctrl+Alt+Shift+V anytime to reopen this list."
                               Foreground="#55FFFFFF" FontSize="11" TextWrapping="Wrap" Margin="4,0,4,4"
                               Visibility="{Binding ClipboardHistory.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}"/>
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ClipboardHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,7" Cursor="Hand" MouseLeftButtonUp="OnClipboardItemClick">
                                        <TextBlock Text="{Binding Preview}" Foreground="White" FontSize="12"
                                                   TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="WindowSwitcherFlyout"
               Placement="Top"
               VerticalOffset="-10"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="OnWindowSwitcherClosed">
            <Border x:Name="WindowSwitcherContent"
                    CornerRadius="14" Background="{DynamicResource FlyoutBackgroundBrush}" Padding="8">
                <ItemsControl x:Name="WindowSwitcherItems" ItemsPanel="{StaticResource HorizontalPanel}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,0" Cursor="Hand" MouseLeftButtonUp="OnWindowSwitcherItemClick">
                                <!-- DWM composites a live thumbnail directly onto this rect at the OS
                                     level (see WindowStyler.ShowThumbnail), painted on top of
                                     whatever WPF draws here, so the "no preview" text underneath
                                     only shows through when a thumbnail didn't register. -->
                                <Grid>
                                    <TextBlock Text="No preview" Foreground="#55FFFFFF" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                    <Border x:Name="ThumbnailHost"
                                            Width="160" Height="100"
                                            CornerRadius="8" Background="#20000000"
                                            BorderBrush="#30FFFFFF" BorderThickness="1"
                                            Loaded="OnThumbnailHostLoaded"
                                            Unloaded="OnThumbnailHostUnloaded"/>
                                </Grid>
                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="11"
                                           TextTrimming="CharacterEllipsis" MaxWidth="160"
                                           HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>

        <Popup x:Name="ShelfFlyout"
               Placement="Top"
               VerticalOffset="-10"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border CornerRadius="18" Background="{DynamicResource FlyoutBackgroundBrush}" Padding="14"
                    BorderBrush="#40FFFFFF" BorderThickness="1" Width="300"
                    AllowDrop="True" Drop="OnShelfDrop">
                <StackPanel>
                    <TextBlock Text="SHELF -- drag items in or out" Foreground="#77FFFFFF" FontSize="10" FontWeight="SemiBold"
                               Margin="4,0,0,8"/>
                    <TextBlock Text="Nothing here yet -- drag a file onto this panel or the shelf icon."
                               Foreground="#55FFFFFF" FontSize="11" TextWrapping="Wrap" Margin="4,0,4,4"
                               Visibility="{Binding ShelfItems.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}"/>
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ShelfItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,6" Cursor="Hand"
                                            MouseLeftButtonDown="OnFileDragMouseDown"
                                            MouseLeftButtonUp="OnShelfItemClick"
                                            MouseMove="OnShelfItemMouseMove"
                                            MouseRightButtonUp="OnShelfItemRightClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                                                   Width="20" Height="20" Margin="0,0,10,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="StackFanFlyout"
               Placement="Top"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Canvas x:Name="StackFanCanvas" Width="500" Height="500" IsHitTestVisible="True">
                <ItemsControl x:Name="StackFanItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding FanOffsetX}"/>
                            <Setter Property="Canvas.Top" Value="{Binding FanOffsetY}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Fixed size because the fan's geometry is computed from it: see the
                                 FanItemHalfWidth/FanItemHalfHeight constants in DockWindow.xaml.cs,
                                 which must stay in step with these numbers. -->
                            <Grid Width="108" Height="86" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="OnFileDragMouseDown"
                                  MouseLeftButtonUp="OnStackFanEntryClick"
                                  MouseMove="OnStackFanEntryMouseMove">
                                <!-- No plate or border behind the icon: the shell icon carries its
                                     own silhouette, and chrome around it only shrank the artwork. -->
                                <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                                       Width="72" Height="72"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Effect>
                                        <!-- Keeps light icons from dissolving into a light desktop
                                             now that there is no plate behind them. -->
                                        <DropShadowEffect Color="Black" BlurRadius="8"
                                                          ShadowDepth="1" Direction="270"
                                                          Opacity="0.55"/>
                                    </Image.Effect>
                                </Image>

                                <!-- The name overlays the icon's lower edge. Legibility over
                                     arbitrary icon artwork comes from an opaque rounded plate
                                     rather than a text outline, which is the only treatment that
                                     holds up against both light and dark icons underneath. -->
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                        MaxWidth="108" CornerRadius="7" Padding="6,2"
                                        Background="#D9101010" BorderBrush="#33FFFFFF"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="6"
                                                          ShadowDepth="0" Opacity="0.7"/>
                                    </Border.Effect>
                                    <!-- Wraps to at most two lines (MaxHeight = 2 * LineHeight)
                                         before ellipsizing, so longer names stay readable without
                                         letting one entry grow unboundedly tall and collide with
                                         the next step of the fan. -->
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                               Foreground="White" FontSize="11"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                               MaxHeight="28" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Popup>
    </Grid>
</Window>
