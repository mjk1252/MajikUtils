<Window x:Class="Dock.App.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Dock.App.Converters"
        Title="Dock"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        Drop="OnDrop"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized">
    <Window.Resources>
        <conv:PngBytesToImageSourceConverter x:Key="PngToImage"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:NameToInitialConverter x:Key="NameToInitial"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility"/>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="VerticalPanel">
            <StackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="TrayIconTemplate">
            <Border Width="34" Height="34" Margin="3,0"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnTrayIconClick"
                    MouseRightButtonUp="OnTrayIconRightClick">
                <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                       Width="20" Height="20"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </DataTemplate>

        <Style x:Key="DockItemStyle" TargetType="Border">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                        <TranslateTransform Y="0"/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX" To="1.25" Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY" To="1.25" Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX" To="1.0" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY" To="1.0" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="GlassBorder"
                CornerRadius="22"
                Padding="12,8"
                Background="#14FFFFFF"
                BorderThickness="1"
                MouseMove="OnGlassMouseMove">
            <Border.BorderBrush>
                <LinearGradientBrush x:Name="RimBrush" StartPoint="0,0" EndPoint="1,0">
                    <GradientStop x:Name="RimStopLeft" Color="#20FFFFFF" Offset="0"/>
                    <GradientStop x:Name="RimStopMid" Color="#45FFFFFF" Offset="0.5"/>
                    <GradientStop x:Name="RimStopRight" Color="#20FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>
                <StackPanel x:Name="ContentStack" Orientation="Horizontal">
                    <ItemsControl x:Name="PinnedItemsControl" ItemsSource="{Binding Items}" ItemsPanel="{StaticResource HorizontalPanel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DockItemStyle}"
                                        ToolTip="{Binding Name}"
                                        MouseLeftButtonUp="OnItemClick"
                                        MouseRightButtonUp="OnItemRightClick">
                                    <Grid>
                                        <Border CornerRadius="10" Background="#4D000000"
                                                Visibility="{Binding IconPng, Converter={StaticResource NullToVisibility}}">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource NameToInitial}}"
                                                       FontSize="20" FontWeight="SemiBold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                                               Width="40" Height="40"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Ellipse Width="5" Height="5" Fill="White"
                                                 VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                 Margin="0,0,0,2"
                                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="Separator1" Width="1" Margin="6,10" Background="#40FFFFFF"/>

                    <Border x:Name="AddButton"
                            Width="52" Height="52" Margin="4,0"
                            Cursor="Hand"
                            ToolTip="Pin an application"
                            MouseLeftButtonUp="OnAddClick">
                        <TextBlock Text="+" FontSize="26" FontWeight="Light"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border x:Name="Separator2" Width="1" Margin="6,10" Background="#40FFFFFF"
                            Visibility="{Binding HasTrayIcons, Converter={StaticResource BoolToVisibility}}"/>

                    <Border x:Name="OverflowChevron"
                            Width="24" Height="34" Margin="0,0,2,0"
                            Cursor="Hand"
                            ToolTip="More tray icons"
                            MouseLeftButtonUp="OnOverflowChevronClick"
                            Visibility="{Binding HasTrayIcons, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="^" FontSize="14" Foreground="#CCFFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border x:Name="Separator3" Width="1" Margin="6,10" Background="#40FFFFFF"/>

                    <Border x:Name="ClockWidget"
                            Padding="12,0" Margin="2,0"
                            Cursor="Hand"
                            MouseLeftButtonUp="OnClockClick">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ClockTimeText" FontSize="15" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ClockDateText" FontSize="10"
                                       Foreground="#CCFFFFFF" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Liquid-glass top highlight: a soft sheen across the upper portion, non-interactive. -->
                <Border CornerRadius="22,22,0,0" IsHitTestVisible="False" VerticalAlignment="Top" Height="20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#20FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Subtle inner shadow along the bottom edge for a sense of glass thickness. -->
                <Border CornerRadius="0,0,22,22" IsHitTestVisible="False" VerticalAlignment="Bottom" Height="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#22000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>

        <Popup x:Name="ClockFlyout"
               Placement="Top"
               VerticalOffset="-10"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border CornerRadius="20" Background="#EE1E1E1E" Padding="24,20"
                    BorderBrush="#40FFFFFF" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="FlyoutTimeText" FontSize="42" FontWeight="Light"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="FlyoutDateText" FontSize="14"
                               Foreground="#CCFFFFFF" HorizontalAlignment="Center" Margin="0,2,0,14"/>
                    <Calendar x:Name="FlyoutCalendar" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="OverflowFlyout"
               Placement="Top"
               VerticalOffset="-10"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border CornerRadius="18" Background="#EE1E1E1E" Padding="10"
                    BorderBrush="#40FFFFFF" BorderThickness="1">
                <ItemsControl ItemsSource="{Binding OverflowTrayIcons}"
                              ItemsPanel="{StaticResource HorizontalPanel}"
                              ItemTemplate="{StaticResource TrayIconTemplate}"/>
            </Border>
        </Popup>
    </Grid>
</Window>
