<Window x:Class="Dock.App.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Dock.App.Converters"
        Title="Dock"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        Drop="OnDrop"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized">
    <Window.Resources>
        <conv:PngBytesToImageSourceConverter x:Key="PngToImage"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:NameToInitialConverter x:Key="NameToInitial"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="DockItemStyle" TargetType="Border">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.25" Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.25" Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="GlassBorder"
            CornerRadius="32"
            Padding="12,8"
            Background="#33FFFFFF"
            BorderBrush="#40FFFFFF"
            BorderThickness="1">
        <StackPanel Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DockItemStyle}"
                                ToolTip="{Binding Name}"
                                MouseLeftButtonUp="OnItemClick"
                                MouseRightButtonUp="OnItemRightClick">
                            <Grid>
                                <Border CornerRadius="10" Background="#4D000000"
                                        Visibility="{Binding IconPng, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="{Binding Name, Converter={StaticResource NameToInitial}}"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                                       Width="40" Height="40"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Ellipse Width="5" Height="5" Fill="White"
                                         VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                         Margin="0,0,0,2"
                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Width="1" Margin="6,10" Background="#40FFFFFF"/>

            <Border x:Name="AddButton"
                    Width="52" Height="52" Margin="4,0"
                    Cursor="Hand"
                    ToolTip="Pin an application"
                    MouseLeftButtonUp="OnAddClick">
                <TextBlock Text="+" FontSize="26" FontWeight="Light"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
