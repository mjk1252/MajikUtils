<views:PanelWindow x:Class="Dock.App.Views.ShelfWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:views="clr-namespace:Dock.App.Views"
                   Title="MajikUtils Shelf"
                   Width="320" Height="300"
                   WindowStyle="None"
                   AllowsTransparency="True"
                   ResizeMode="CanMinimize"
                   AllowDrop="True"
                   DragEnter="OnDragEnter"
                   DragLeave="OnDragLeave"
                   Drop="OnDrop">
    <Border Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="OnHeaderDrag" Background="Transparent">
                <TextBlock Text="SHELF -- drop files here" Style="{StaticResource SectionHeaderText}"/>
                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                           Foreground="#99FFFFFF" Cursor="Hand"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           ToolTip="Put away"
                           MouseLeftButtonUp="OnMinimiseClick"/>
            </Grid>

            <!-- Highlights while a drag is over the window, so it reads as a target rather than
                 just a list that happens to be showing. -->
            <Border x:Name="DropHint" Grid.Row="1" Grid.RowSpan="2"
                    CornerRadius="8" BorderThickness="1" BorderBrush="Transparent"
                    Background="Transparent" IsHitTestVisible="False" Panel.ZIndex="1"/>

            <TextBlock Grid.Row="1" Style="{StaticResource EmptyStateText}"
                       Text="Drag files here to hold them, then drag them back out wherever you need them."
                       Visibility="{Binding ShelfItems.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ShelfItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListRow}"
                                    MouseLeftButtonDown="OnRowMouseDown"
                                    MouseLeftButtonUp="OnRowClick"
                                    MouseMove="OnRowMouseMove"
                                    MouseRightButtonUp="OnRowRightClick">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                                           Width="20" Height="20" Margin="0,0,10,0"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</views:PanelWindow>
