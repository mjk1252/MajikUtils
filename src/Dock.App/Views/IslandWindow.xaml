<Window x:Class="Dock.App.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Dock.App.Views"
        xmlns:panels="clr-namespace:Dock.App.Views.Panels"
        xmlns:vm="clr-namespace:Dock.Core.ViewModels;assembly=Dock.Core"
        Title="MajikUtils Island"
        Width="760" Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        DragEnter="OnDragEnter"
        DragOver="OnDragEnter"
        DragLeave="OnDragLeave"
        Drop="OnDrop">
    <Window.Resources>
        <!-- Glyphs come from the shell's own icon font, with the Windows 10 name as a fallback. -->
        <FontFamily x:Key="GlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- The scope strip. Icon-only until it is the one you are in, and then it says its
             name: a row of seven unlabelled glyphs is a toolbar nobody reads, and seven labels at
             once is a menu bar. One label at a time is how the other six get learned.

             The lit plate takes the artwork's colour, which is the accent's main job in this
             window - it marks the one place you are, in the colour of the thing you are hearing. -->
        <Style x:Key="IslandScope" TargetType="ToggleButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FontFamily" Value="{StaticResource GlyphFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Plate" Background="Transparent" CornerRadius="8"
                                BorderThickness="1" BorderBrush="Transparent" Padding="8,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center"/>

                                <!-- Collapsed rather than zero-width: an empty TextBlock still
                                     carries its margin, which would leave every unlit scope seven
                                     pixels wider than it looks. -->
                                <TextBlock x:Name="Label" Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe UI" FontSize="11" Margin="7,0,1,0"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Plate" Property="Background"
                                        Value="{DynamicResource IslandAccentSoftBrush}"/>
                                <Setter TargetName="Plate" Property="BorderBrush"
                                        Value="{DynamicResource IslandAccentBrush}"/>
                                <Setter TargetName="Label" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The gear: same silhouette as a scope, but it opens a window rather than a place, so it
             is a Button and never stays lit. -->
        <Style x:Key="IslandScopeButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontFamily" Value="{StaticResource GlyphFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- What the collapsed pill shows when media holds it. One of a set: the pill is a
             ContentControl over whichever activity is primary, and each activity's collapsed form
             is a template like this one, picked by the type of the view model.

             A grid rather than a row of stacked children, and fixed to the pill's own width: art,
             artist and bars take what they need and the title gets the rest, so a long title trims
             instead of pushing the bars out past the clip.

             HasSession rather than the activity's IsActive: between two tracks the session is gone
             but the island is still holding the last one up, and this has to keep drawing it. -->
        <DataTemplate DataType="{x:Type vm:MediaViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="22" Height="22" CornerRadius="4" Margin="0,0,9,0"
                        Background="#22FFFFFF"
                        Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
                    <Border.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Border Width="22" Height="22" CornerRadius="4" Background="White"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.OpacityMask>
                    <Image Source="{Binding Artwork, Converter={StaticResource PngToImage}}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource IslandBodyText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}"/>

                <TextBlock Grid.Column="2" Text="{Binding Artist}" Style="{StaticResource IslandMetaText}"
                           VerticalAlignment="Center" MaxWidth="84" Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}"/>

                <!-- The window supplies "on screen and collapsed"; the control ANDs that with the
                     track actually playing. Both reached by RelativeSource because a template has
                     no other way back to the window that hosts it. -->
                <views:NowPlayingBars Grid.Column="3" Margin="10,0,0,0"
                                      IsPlaying="{Binding IsPlaying}"
                                      Artwork="{Binding Artwork}"
                                      IsRunning="{Binding IsCollapsedShowing,
                                          RelativeSource={RelativeSource AncestorType=views:IslandWindow}}"
                                      AudioSource="{Binding AudioSource,
                                          RelativeSource={RelativeSource AncestorType=views:IslandWindow}}"
                                      Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </DataTemplate>

        <!-- The same green macOS uses for its own camera dot. The convention is worth more here
             than originality: a green dot at the top of the screen already means "the camera is
             on" to a great many people. -->
        <SolidColorBrush x:Key="CameraInUseBrush" Color="#30D158"/>

        <!-- ChipButton lives in App.xaml: the section panels are UserControls in their own XAML
             files and cannot see a style declared on this window. -->

        <!-- Announcements and conditions in the pill: a glyph, a headline, and the particulars if
             there are any. One template covers every source that has this shape. -->
        <DataTemplate DataType="{x:Type vm:AnnouncementActivity}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource GlyphFont}"
                           FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Label}" Style="{StaticResource IslandBodyText}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource IslandMetaText}"
                           VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="120"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ConditionActivity}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource GlyphFont}"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Label}" Style="{StaticResource IslandBodyText}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TimerActivity}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE916;" FontFamily="{StaticResource GlyphFont}"
                           FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="{Binding RemainingText}" Style="{StaticResource IslandBodyText}"
                           VerticalAlignment="Center"/>

                <!-- Trimmed hard: the collapsed pill is one line and the number is the part that
                     has to survive. -->
                <TextBlock Text="{Binding Label}" Style="{StaticResource IslandMetaText}"
                           VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="120"
                           Visibility="{Binding HasLabel, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- The compact forms: what an activity looks like sitting *beside* the pill rather than
             in it. Keyed by convention and resolved by CompactActivityTemplateSelector. -->
        <DataTemplate x:Key="Compact.PrivacyViewModel">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{StaticResource CameraInUseBrush}"
                     ToolTip="{Binding Summary}"/>
        </DataTemplate>

        <!-- Media beside the pill is the artwork and nothing else. It only lands here once
             something outranks it, such as a timer or an announcement, and at that point the cover
             is both the most recognisable thing about a track and the only part of it that
             survives being shrunk to a circle. -->
        <DataTemplate x:Key="Compact.MediaViewModel">
            <Border Width="22" Height="22" CornerRadius="11" Background="#22FFFFFF">
                <Border.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border Width="22" Height="22" CornerRadius="11" Background="White"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>
                <Image Source="{Binding Artwork, Converter={StaticResource PngToImage}}"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </DataTemplate>

        <!-- A timer is the one activity with a live value worth drawing small, so its compact form
             is a ring rather than a dot: it says how far along at a glance without a single word. -->
        <DataTemplate x:Key="Compact.TimerActivity">
            <Grid Width="26" Height="26">
                <Ellipse Width="26" Height="26" Stroke="#33FFFFFF" StrokeThickness="2.5"/>
                <Path Data="{Binding Progress, Converter={StaticResource ProgressToArc}}"
                      Stroke="#FF9F0A" StrokeThickness="2.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
        </DataTemplate>

        <SolidColorBrush x:Key="ProgressBrush" Color="#0A84FF"/>

        <!-- A job in the bubble: the same ring the timer uses, because the timer was never the only
             thing with a number between nought and one. An indeterminate job draws the track alone,
             which reads as "started" without claiming a figure it does not have. -->
        <DataTemplate x:Key="Compact.ProgressActivity">
            <Grid Width="26" Height="26" ToolTip="{Binding Label}">
                <Ellipse Width="26" Height="26" Stroke="#33FFFFFF" StrokeThickness="2.5"/>
                <Path Data="{Binding Progress, Converter={StaticResource ProgressToArc}}"
                      Stroke="{StaticResource ProgressBrush}" StrokeThickness="2.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Visibility="{Binding IsIndeterminate,
                          Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>

                <!-- Something has to move while there is no figure, or a stalled install and a
                     starting one look identical. -->
                <Ellipse Width="6" Height="6" Fill="{StaticResource ProgressBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding IsIndeterminate,
                             Converter={StaticResource BoolToVisibility}}">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0.15" Duration="0:0:0.9"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
            </Grid>
        </DataTemplate>

        <!-- With nothing playing it takes the pill, and then it can use words. -->
        <DataTemplate DataType="{x:Type vm:ProgressActivity}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE896;" FontFamily="{StaticResource GlyphFont}"
                           FontSize="12" Foreground="{StaticResource ProgressBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Label}" Style="{StaticResource IslandBodyText}"
                           VerticalAlignment="Center" MaxWidth="150"/>
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource IslandMetaText}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- The expanded row, where there is room for a bar rather than a ring. -->
        <DataTemplate x:Key="Expanded.ProgressActivity">
            <Grid Margin="4,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Label}" Style="{StaticResource IslandBodyText}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="{Binding ProgressText}"
                           Style="{StaticResource IslandMetaText}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>

                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="3" Margin="0,7,0,0"
                             Minimum="0" Maximum="1" Background="#2EFFFFFF"
                             Foreground="{StaticResource ProgressBrush}"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Value="{Binding Progress, Mode=OneWay}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Compact.AnnouncementActivity">
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource GlyphFont}"
                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="Compact.ConditionActivity">
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource GlyphFont}"
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       ToolTip="{Binding Label}"/>
        </DataTemplate>

        <DataTemplate x:Key="CompactActivityFallback">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                    Fill="{StaticResource TextSecondaryBrush}"/>
        </DataTemplate>

        <views:CompactActivityTemplateSelector x:Key="CompactActivity"
                                               Fallback="{StaticResource CompactActivityFallback}"/>

        <!-- Deliberately empty, and deliberately not null: see the selector. -->
        <DataTemplate x:Key="ExpandedActivityEmpty"/>

        <views:ExpandedActivityTemplateSelector x:Key="ExpandedActivity"
                                                Empty="{StaticResource ExpandedActivityEmpty}"/>

        <DataTemplate x:Key="Expanded.TimerActivity">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                <TextBlock Text="&#xE916;" FontFamily="{StaticResource GlyphFont}" FontSize="13"
                           Foreground="#FF9F0A" VerticalAlignment="Center" Margin="4,0,10,0"/>
                <TextBlock Text="{Binding RemainingText}"
                           Style="{StaticResource IslandTitleText}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- Only a named countdown has anything to say here, and a reminder is exactly a
                     countdown with a name on it. -->
                <TextBlock Text="{Binding Label}" Style="{StaticResource IslandMetaText}"
                           VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="220"
                           Visibility="{Binding HasLabel, Converter={StaticResource BoolToVisibility}}"/>

                <Button Content="Stop" Style="{StaticResource ChipButton}"
                        Command="{Binding CancelCommand}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Expanded.ConditionActivity">
            <StackPanel Orientation="Horizontal" Margin="4,0,0,8" VerticalAlignment="Center">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource GlyphFont}"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Label}" Style="{StaticResource IslandBodyText}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- An activity's row in the expanded panel. Media has none by design: its expanded form is
             the artwork and transport block below, not a row up here. -->
        <DataTemplate x:Key="Expanded.PrivacyViewModel">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="CAMERA IN USE" Style="{StaticResource SectionHeaderText}"/>

                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,4">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource CameraInUseBrush}"/>

                                <!-- Collapsed rather than left empty when there is no icon: a
                                     packaged app is named by package family and has no path to
                                     extract one from, and an empty box reads as a failed load. -->
                                <Border Width="16" Height="16" CornerRadius="3"
                                        Margin="0,0,8,0" VerticalAlignment="Center"
                                        Visibility="{Binding IconPng,
                                            Converter={StaticResource NullToVisibility},
                                            ConverterParameter=invert}">
                                    <Image Source="{Binding IconPng,
                                               Converter={StaticResource PngToImage}}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <TextBlock Text="{Binding Name}" MaxWidth="280"
                                           Style="{StaticResource IslandBodyText}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Same shape as the privacy dot: a coloured mark, an icon, a name. An application making
             sound and one holding the camera are the same kind of fact: a glance is enough, a
             sentence is too much. -->
        <SolidColorBrush x:Key="MixerActiveBrush" Color="#FF9F0A"/>

        <DataTemplate x:Key="Compact.VolumeMixerActivity">
            <TextBlock Text="&#xE767;" FontFamily="{StaticResource GlyphFont}"
                       FontSize="12" Foreground="{StaticResource MixerActiveBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       ToolTip="{Binding Summary}"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:VolumeMixerActivity}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE767;" FontFamily="{StaticResource GlyphFont}"
                           FontSize="12" Foreground="{StaticResource MixerActiveBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding Icon, Converter={StaticResource NullToVisibility},
                            ConverterParameter=invert}">
                    <Image Source="{Binding Icon, Converter={StaticResource PngToImage}}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Text="{Binding Summary}" Style="{StaticResource IslandBodyText}"
                           VerticalAlignment="Center" MaxWidth="180"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <!-- What the collapsed pill shows when something is using the camera. -->
        <DataTemplate DataType="{x:Type vm:PrivacyViewModel}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0"
                         Fill="{StaticResource CameraInUseBrush}"/>

                <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,7,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding Icon, Converter={StaticResource NullToVisibility},
                            ConverterParameter=invert}">
                    <Image Source="{Binding Icon, Converter={StaticResource PngToImage}}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Text="{Binding Summary}" Style="{StaticResource IslandBodyText}"
                           VerticalAlignment="Center" MaxWidth="180"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- The window itself stays the full expanded footprint and never resizes: only the pill
         inside it grows and shrinks. Animating a layered top-level window's bounds per frame is
         what makes overlays like this stutter.

         Which means Height above is a ceiling on everything below it: the pill cannot draw past
         the window, so this has to clear the tallest the panel ever gets, which is the artwork and
         transport controls plus the notes list at its full five entries. -->
    <Grid>
        <Grid x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0">
            <Grid.RenderTransform>
                <!-- Parked just above the screen edge, so showing it is a drop rather than a fade. -->
                <TranslateTransform x:Name="PillSlide" Y="-40"/>
            </Grid.RenderTransform>

            <!-- The silhouette is drawn rather than bordered, so its top corners can flare back
                 out into the screen edge. Its size is animated in step with the content host
                 below, which is the one that clips. -->
            <views:NotchShape x:Name="Notch"
                              PillWidth="260" PillHeight="34" BottomRadius="17" Fillet="14"
                              HorizontalAlignment="Center" VerticalAlignment="Top"
                              Fill="#F2101010"
                              Stroke="{StaticResource PanelBorderBrush}" StrokeThickness="1">
                <views:NotchShape.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55" Color="Black"/>
                </views:NotchShape.Effect>
            </views:NotchShape>

            <!-- The runner-up activity, split off into a form of its own beside the pill.

                 A sibling of the silhouette rather than a child of the content host, because that
                 host clips: the bubble is outside the pill, which is the entire point of it. Being
                 inside the Pill grid still gets it the drop-in slide and the show/hide fade for
                 free, so there is only ever one of each animation to keep in step.

                 Placed from code (PlaceBubble) rather than by a margin: which side it sits on and
                 how far out depend on the island's shape and which end of the edge it is parked
                 at, and a margin on a centre-aligned element shifts it by half its value. -->
            <Grid x:Name="Bubble" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Opacity="0" RenderTransformOrigin="0,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <!-- Grows out of the edge facing the pill, so it reads as the island
                             splitting rather than as a notification appearing next to it. -->
                        <ScaleTransform x:Name="BubbleScale" ScaleX="0.3" ScaleY="0.3"/>
                        <TranslateTransform x:Name="BubbleSlide"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <views:NotchShape x:Name="BubbleShape"
                                  PillWidth="34" PillHeight="34" BottomRadius="17" Fillet="8"
                                  HorizontalAlignment="Center" VerticalAlignment="Top"
                                  Fill="#F2101010"
                                  Stroke="{StaticResource PanelBorderBrush}" StrokeThickness="1">
                    <views:NotchShape.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55" Color="Black"/>
                    </views:NotchShape.Effect>
                </views:NotchShape>

                <Border x:Name="BubbleContentHost" Width="34" Height="34"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Background="Transparent">
                    <ContentControl Content="{Binding Secondary}"
                                    ContentTemplateSelector="{StaticResource CompactActivity}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <Border x:Name="PillContent"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Width="260" Height="34"
                    Background="Transparent"
                    ClipToBounds="True"
                    MouseLeftButtonDown="OnPillClick">
                <Grid>
                    <!-- Collapsed: whichever activity currently holds the pill, at a glance. Its
                         DataContext is the activity host, set in the constructor; the form each
                         activity takes here is a DataTemplate up in Window.Resources. -->
                    <Grid x:Name="CollapsedLayer" Width="236" Height="22"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentControl Content="{Binding Primary}"/>

                        <!-- The idle peek: hovering the top edge with nothing playing still gets an
                             answer, rather than the island appearing to be broken.

                             The island's empty state rather than media's, which is why it sits out
                             here beside the ContentControl instead of inside a template: with no
                             activity there is no template being drawn to put it in. -->
                        <TextBlock Text="Nothing playing"
                                   Style="{StaticResource IslandFaintText}" FontSize="11.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Primary, Converter={StaticResource NullToVisibility}}"/>
                    </Grid>

                    <!-- Expanded. Five bands, top to bottom, and the reading order is the point:
                         what the island is telling you, what is playing, where you can go, the one
                         box, and the place you went.

                         The box sits above the section rather than inside one, which is the whole
                         of the command palette merge: it used to live in the Capture pane, so it
                         only existed while you were looking at that pane, and a second window with
                         a second search box existed to cover everywhere else. One box over every
                         scope is the same box that window was.

                         Three of these bands only exist once the island is *pinned*. A hover is a
                         glance - it answers "what is this" and nothing else. See UpdateChrome. -->
                    <Grid x:Name="ExpandedLayer" Opacity="0" IsHitTestVisible="False"
                          Width="440" Margin="20,16,20,16"
                          HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- One row per showing activity that has something to say up here. Rows
                             rather than scopes: the scope strip is for places a person navigates
                             to, and these are conditions, not places.

                             Generic on purpose. Every activity added from here on is a view model,
                             two templates and a registration: no surgery on this window, and no
                             renumbering the rows below every time. -->
                        <ItemsControl x:Name="ActivityRows"
                                      ItemsSource="{Binding Showing}"
                                      ItemTemplateSelector="{StaticResource ExpandedActivity}"/>

                        <!-- What is playing. One control at one of two densities rather than the
                             two parallel blocks this used to be - see NowPlayingView. -->
                        <views:NowPlayingView x:Name="NowPlaying" Grid.Row="1"
                                              AudioSource="{Binding AudioSource,
                                                  RelativeSource={RelativeSource AncestorType=views:IslandWindow}}"
                                              Visibility="{Binding HasSession,
                                                  Converter={StaticResource BoolToVisibility}}"/>

                        <!-- The answer to a hover with nothing playing. Without it the island opens
                             on an empty box and reads as broken. -->
                        <TextBlock x:Name="IdleLine" Grid.Row="1" Text="Nothing playing"
                                   Style="{StaticResource IslandFaintText}"
                                   HorizontalAlignment="Center" Margin="0,4,0,4"
                                   Visibility="{Binding HasSession,
                                       Converter={StaticResource BoolToVisibility},
                                       ConverterParameter=invert}"/>

                        <!-- Navigation, at the top of the content it navigates rather than along
                             the bottom of it. Seven 28px glyphs in a corner were a toolbar nobody
                             could read: the lit one now says its name, which is enough to learn the
                             other six by. -->
                        <Grid x:Name="NavBar" Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="QuickTab" Style="{StaticResource IslandScope}"
                                              Content="&#xE70B;" Tag="Capture"
                                              Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>
                                <ToggleButton x:Name="ShelfTab" Style="{StaticResource IslandScope}"
                                              Content="&#xE8B7;" Tag="Shelf"
                                              Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>
                                <ToggleButton x:Name="ClipboardTab" Style="{StaticResource IslandScope}"
                                              Content="&#xE8C8;" Tag="Clipboard"
                                              Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>
                                <ToggleButton x:Name="LauncherTab" Style="{StaticResource IslandScope}"
                                              Content="&#xE721;" Tag="Apps"
                                              Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>
                                <ToggleButton x:Name="RecentTab" Style="{StaticResource IslandScope}"
                                              Content="&#xE81C;" Tag="Recent"
                                              Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>
                                <ToggleButton x:Name="StacksTab" Style="{StaticResource IslandScope}"
                                              Content="&#xE838;" Tag="Stacks"
                                              Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>
                                <ToggleButton x:Name="MixerTab" Style="{StaticResource IslandScope}"
                                              Content="&#xE767;" Tag="Mixer"
                                              Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>
                            </StackPanel>

                            <TextBlock x:Name="StatsText" Grid.Column="1"
                                       Style="{StaticResource IslandFaintText}" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <Button x:Name="SettingsButton" Grid.Column="2"
                                    Style="{StaticResource IslandScopeButton}"
                                    Content="&#xE713;" ToolTip="Settings"
                                    Click="OnSettingsClick"/>
                        </Grid>

                        <!-- The one box. What you type decides what it becomes, and a leading slash
                             makes it a search over everything the app already knows how to find -
                             which is what the separate palette window was for. -->
                        <Grid x:Name="CaptureBar" Grid.Row="3" Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- The rule under the box is the only chrome it gets, and it takes
                                 the artwork's colour while the caret is in it: the one place the
                                 accent marks focus rather than state. -->
                            <Border x:Name="CaptureBox" BorderThickness="0,0,0,1"
                                    Padding="2,0,2,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource PanelBorderBrush}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource IslandAccentBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Turns into a magnifier the moment the line becomes a
                                         search, so the box says which of its two jobs it is
                                         currently doing without a word. -->
                                    <TextBlock x:Name="CaptureGlyph" Text="&#xE70F;"
                                               FontFamily="{StaticResource GlyphFont}" FontSize="12"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <Grid Grid.Column="1">
                                        <TextBlock x:Name="CapturePlaceholder"
                                                   Text="Type a task, 25m, .note or /search"
                                                   Style="{StaticResource IslandFaintText}"
                                                   FontSize="12.5" IsHitTestVisible="False"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding DraftText.Length,
                                                       Converter={StaticResource CountToVisibility},
                                                       ConverterParameter=invert}"/>

                                        <TextBox x:Name="CaptureInput" Style="{StaticResource CaptureText}"
                                                 FontSize="12.5"
                                                 Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- What the box has decided this line is, said back before Enter
                                 commits it. The grammar is six rules; this is how anybody finds
                                 out about the other five. -->
                            <Grid Grid.Row="1" Margin="2,8,2,0">
                                <TextBlock x:Name="CaptureHint"
                                           Style="{StaticResource IslandFaintText}"
                                           FontSize="10" VerticalAlignment="Center"/>

                                <Border Style="{StaticResource InlineActionHost}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0" MouseLeftButtonUp="OnClearDoneClick"
                                        Visibility="{Binding HasDone,
                                            Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Clear done" Style="{StaticResource InlineAction}"/>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- One host, every section kept alive inside it: switching scopes hides
                             and shows rather than rebuilding, so a search box keeps its text and a
                             list its scroll position across a switch. -->
                        <Grid x:Name="SectionHost" Grid.Row="4" Margin="0,12,0,0">
                            <!-- Tasks and notes in one feed, newest first. They were two lists
                                 under two headers; they are captured in the same moment and re-read
                                 in the same moment, and the difference between them is one checkbox
                                 wide. -->
                            <Grid x:Name="QuickView">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox IsChecked="{Binding Todo.IsDone}"
                                                          Style="{StaticResource IslandCheckBox}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          Visibility="{Binding IsTodo,
                                                              Converter={StaticResource BoolToVisibility}}"/>

                                                <!-- A note gets the same 22px gutter with a dot in
                                                     it rather than nothing, so the two kinds of row
                                                     share a text baseline instead of stepping. -->
                                                <Ellipse Width="4" Height="4"
                                                         Fill="{StaticResource TextTertiaryBrush}"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Left" Margin="5,0,0,0"
                                                         Visibility="{Binding IsNote,
                                                             Converter={StaticResource BoolToVisibility}}"/>

                                                <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock"
                                                               BasedOn="{StaticResource IslandBodyText}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Todo.IsDone}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{StaticResource TextTertiaryBrush}"/>
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Grid.Column="2" Text="{Binding TimeText}"
                                                           Style="{StaticResource IslandFaintText}"
                                                           FontSize="10" VerticalAlignment="Center"
                                                           Margin="10,0,0,0"
                                                           Visibility="{Binding IsNote,
                                                               Converter={StaticResource BoolToVisibility}}"/>

                                                <Border Grid.Column="2" Style="{StaticResource InlineActionHost}"
                                                        VerticalAlignment="Center" Margin="6,0,0,0"
                                                        ToolTip="Remove"
                                                        MouseLeftButtonUp="OnRemoveTodoClick"
                                                        Visibility="{Binding IsTodo,
                                                            Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="&#xE711;" Style="{StaticResource InlineAction}"
                                                               FontFamily="{StaticResource GlyphFont}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- The feed is capped so the island cannot grow off the bottom of
                                     the screen. Whatever is past the cap is counted rather than
                                     silently dropped. -->
                                <TextBlock Grid.Row="1" Margin="22,2,0,0"
                                           Style="{StaticResource IslandFaintText}" FontSize="10"
                                           Text="{Binding OverflowCount, StringFormat={}{0} older}"
                                           Visibility="{Binding OverflowCount,
                                               Converter={StaticResource CountToVisibility}}"/>
                            </Grid>

                            <!-- Where a slash goes. The command palette's list, re-hosted: same
                                 view model, same ranking, same keyboard, one fewer window. -->
                            <panels:SearchPanel x:Name="SearchView" Visibility="Collapsed"/>

                            <!-- The former taskbar panels, re-hosted. Their DataContext is the dock
                                 view model, set once from code-behind on this host's children. -->
                            <panels:ShelfPanel x:Name="ShelfView" Visibility="Collapsed"/>
                            <panels:ClipboardPanel x:Name="ClipboardView" Visibility="Collapsed"/>
                            <panels:LauncherPanel x:Name="LauncherView" Visibility="Collapsed"/>
                            <panels:RecentPanel x:Name="RecentView" Visibility="Collapsed"/>
                            <panels:StacksPanel x:Name="StacksView" Visibility="Collapsed"/>
                            <panels:MixerPanel x:Name="MixerView" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
