<Window x:Class="Dock.App.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Dock.App.Views"
        xmlns:panels="clr-namespace:Dock.App.Views.Panels"
        xmlns:vm="clr-namespace:Dock.Core.ViewModels;assembly=Dock.Core"
        Title="MajikUtils Island"
        Width="760" Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        DragEnter="OnDragEnter"
        DragOver="OnDragEnter"
        DragLeave="OnDragLeave"
        Drop="OnDrop">
    <Window.Resources>
        <!-- Glyphs come from the shell's own icon font, with the Windows 10 name as a fallback. -->
        <FontFamily x:Key="GlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource GlyphFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="Transparent" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The stock template carries a gradient and an animated glow that read as a dialog
             control; this is a plain 4px rule with a rounded fill. -->
        <Style x:Key="IslandProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Background" Value="#2EFFFFFF"/>
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <Grid>
                                <Rectangle x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- The tab strip's buttons. Icon-only and small: this row sits under a media panel, not
             beside it, so anything with a label would read as the island's main content. -->
        <Style x:Key="IslandTab" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontFamily" Value="{StaticResource GlyphFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Plate" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The gear: same silhouette as a tab, but it opens a window rather than a section, so it
             is a Button and never stays lit. -->
        <Style x:Key="IslandTabButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontFamily" Value="{StaticResource GlyphFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caret and selection are the only chrome a stock TextBox brings that still belongs here;
             everything else reads as a form field dropped onto a HUD. -->
        <Style x:Key="NoteInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- What the collapsed pill shows when media holds it. One of a set: the pill is a
             ContentControl over whichever activity is primary, and each activity's collapsed form
             is a template like this one, picked by the type of the view model.

             A grid rather than a row of stacked children, and fixed to the pill's own width: art,
             artist and bars take what they need and the title gets the rest, so a long title trims
             instead of pushing the bars out past the clip.

             HasSession rather than the activity's IsActive: between two tracks the session is gone
             but the island is still holding the last one up, and this has to keep drawing it. -->
        <DataTemplate DataType="{x:Type vm:MediaViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="22" Height="22" CornerRadius="4" Margin="0,0,9,0"
                        Background="#22FFFFFF"
                        Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
                    <Border.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Border Width="22" Height="22" CornerRadius="4" Background="White"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.OpacityMask>
                    <Image Source="{Binding Artwork, Converter={StaticResource PngToImage}}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" FontSize="11.5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}"/>

                <TextBlock Grid.Column="2" Text="{Binding Artist}" Foreground="#88FFFFFF" FontSize="11"
                           VerticalAlignment="Center" MaxWidth="84" Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}"/>

                <!-- The window supplies "on screen and collapsed"; the control ANDs that with the
                     track actually playing. Both reached by RelativeSource because a template has
                     no other way back to the window that hosts it. -->
                <views:NowPlayingBars Grid.Column="3" Margin="10,0,0,0"
                                      IsPlaying="{Binding IsPlaying}"
                                      Artwork="{Binding Artwork}"
                                      IsRunning="{Binding IsCollapsedShowing,
                                          RelativeSource={RelativeSource AncestorType=views:IslandWindow}}"
                                      AudioSource="{Binding AudioSource,
                                          RelativeSource={RelativeSource AncestorType=views:IslandWindow}}"
                                      Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </DataTemplate>

        <!-- The same green macOS uses for its own camera dot. The convention is worth more here
             than originality: a green dot at the top of the screen already means "the camera is
             on" to a great many people. -->
        <SolidColorBrush x:Key="CameraInUseBrush" Color="#30D158"/>

        <!-- A small labelled action inside a panel, as opposed to the icon-only tabs below. -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="#16FFFFFF" CornerRadius="9"
                                Padding="9,3" BorderThickness="1"
                                BorderBrush="{StaticResource PanelBorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#2EFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Announcements and conditions in the pill: a glyph, a headline, and the particulars if
             there are any. One template covers every source that has this shape. -->
        <DataTemplate DataType="{x:Type vm:AnnouncementActivity}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource GlyphFont}"
                           FontSize="12" Foreground="White" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11.5"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Detail}" Foreground="#88FFFFFF" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="120"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ConditionActivity}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource GlyphFont}"
                           FontSize="12" Foreground="#CCFFFFFF" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Label}" Foreground="#CCFFFFFF" FontSize="11.5"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TimerActivity}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE916;" FontFamily="{StaticResource GlyphFont}"
                           FontSize="12" Foreground="White" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="{Binding RemainingText}" Foreground="White" FontSize="11.5"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- The compact forms: what an activity looks like sitting *beside* the pill rather than
             in it. Keyed by convention and resolved by CompactActivityTemplateSelector. -->
        <DataTemplate x:Key="Compact.PrivacyViewModel">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{StaticResource CameraInUseBrush}"
                     ToolTip="{Binding Summary}"/>
        </DataTemplate>

        <!-- Media beside the pill is the artwork and nothing else. It only lands here once
             something outranks it, such as a timer or an announcement, and at that point the cover
             is both the most recognisable thing about a track and the only part of it that
             survives being shrunk to a circle. -->
        <DataTemplate x:Key="Compact.MediaViewModel">
            <Border Width="22" Height="22" CornerRadius="11" Background="#22FFFFFF">
                <Border.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border Width="22" Height="22" CornerRadius="11" Background="White"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>
                <Image Source="{Binding Artwork, Converter={StaticResource PngToImage}}"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </DataTemplate>

        <!-- A timer is the one activity with a live value worth drawing small, so its compact form
             is a ring rather than a dot: it says how far along at a glance without a single word. -->
        <DataTemplate x:Key="Compact.TimerActivity">
            <Grid Width="26" Height="26">
                <Ellipse Width="26" Height="26" Stroke="#33FFFFFF" StrokeThickness="2.5"/>
                <Path Data="{Binding Progress, Converter={StaticResource ProgressToArc}}"
                      Stroke="#FF9F0A" StrokeThickness="2.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Compact.AnnouncementActivity">
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource GlyphFont}"
                       FontSize="13" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="Compact.ConditionActivity">
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource GlyphFont}"
                       FontSize="12" Foreground="#AAFFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       ToolTip="{Binding Label}"/>
        </DataTemplate>

        <DataTemplate x:Key="CompactActivityFallback">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="#88FFFFFF"/>
        </DataTemplate>

        <views:CompactActivityTemplateSelector x:Key="CompactActivity"
                                               Fallback="{StaticResource CompactActivityFallback}"/>

        <!-- Deliberately empty, and deliberately not null: see the selector. -->
        <DataTemplate x:Key="ExpandedActivityEmpty"/>

        <views:ExpandedActivityTemplateSelector x:Key="ExpandedActivity"
                                                Empty="{StaticResource ExpandedActivityEmpty}"/>

        <DataTemplate x:Key="Expanded.TimerActivity">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                <TextBlock Text="&#xE916;" FontFamily="{StaticResource GlyphFont}" FontSize="13"
                           Foreground="#FF9F0A" VerticalAlignment="Center" Margin="4,0,10,0"/>
                <TextBlock Text="{Binding RemainingText}" Foreground="White" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Stop" Style="{StaticResource ChipButton}"
                        Command="{Binding CancelCommand}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Expanded.ConditionActivity">
            <StackPanel Orientation="Horizontal" Margin="4,0,0,8" VerticalAlignment="Center">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource GlyphFont}"
                           FontSize="12" Foreground="#AAFFFFFF"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Label}" Foreground="#CCFFFFFF" FontSize="11.5"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- An activity's row in the expanded panel. Media has none by design: its expanded form is
             the artwork and transport block below, not a row up here. -->
        <DataTemplate x:Key="Expanded.PrivacyViewModel">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="CAMERA IN USE" Style="{StaticResource SectionHeaderText}"/>

                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,4">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource CameraInUseBrush}"/>

                                <!-- Collapsed rather than left empty when there is no icon: a
                                     packaged app is named by package family and has no path to
                                     extract one from, and an empty box reads as a failed load. -->
                                <Border Width="16" Height="16" CornerRadius="3"
                                        Margin="0,0,8,0" VerticalAlignment="Center"
                                        Visibility="{Binding IconPng,
                                            Converter={StaticResource NullToVisibility},
                                            ConverterParameter=invert}">
                                    <Image Source="{Binding IconPng,
                                               Converter={StaticResource PngToImage}}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <TextBlock Text="{Binding Name}" Foreground="White"
                                           FontSize="11.5" VerticalAlignment="Center"
                                           MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Same shape as the privacy dot: a coloured mark, an icon, a name. An application making
             sound and one holding the camera are the same kind of fact: a glance is enough, a
             sentence is too much. -->
        <SolidColorBrush x:Key="MixerActiveBrush" Color="#FF9F0A"/>

        <DataTemplate x:Key="Compact.VolumeMixerActivity">
            <TextBlock Text="&#xE767;" FontFamily="{StaticResource GlyphFont}"
                       FontSize="12" Foreground="{StaticResource MixerActiveBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       ToolTip="{Binding Summary}"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:VolumeMixerActivity}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE767;" FontFamily="{StaticResource GlyphFont}"
                           FontSize="12" Foreground="{StaticResource MixerActiveBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>

                <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding Icon, Converter={StaticResource NullToVisibility},
                            ConverterParameter=invert}">
                    <Image Source="{Binding Icon, Converter={StaticResource PngToImage}}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Text="{Binding Summary}" Foreground="White" FontSize="11.5"
                           VerticalAlignment="Center" MaxWidth="180"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <!-- What the collapsed pill shows when something is using the camera. -->
        <DataTemplate DataType="{x:Type vm:PrivacyViewModel}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0"
                         Fill="{StaticResource CameraInUseBrush}"/>

                <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,7,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding Icon, Converter={StaticResource NullToVisibility},
                            ConverterParameter=invert}">
                    <Image Source="{Binding Icon, Converter={StaticResource PngToImage}}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Text="{Binding Summary}" Foreground="White" FontSize="11.5"
                           VerticalAlignment="Center" MaxWidth="180"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- The window itself stays the full expanded footprint and never resizes: only the pill
         inside it grows and shrinks. Animating a layered top-level window's bounds per frame is
         what makes overlays like this stutter.

         Which means Height above is a ceiling on everything below it: the pill cannot draw past
         the window, so this has to clear the tallest the panel ever gets, which is the artwork and
         transport controls plus the notes list at its full five entries. -->
    <Grid>
        <Grid x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0">
            <Grid.RenderTransform>
                <!-- Parked just above the screen edge, so showing it is a drop rather than a fade. -->
                <TranslateTransform x:Name="PillSlide" Y="-40"/>
            </Grid.RenderTransform>

            <!-- The silhouette is drawn rather than bordered, so its top corners can flare back
                 out into the screen edge. Its size is animated in step with the content host
                 below, which is the one that clips. -->
            <views:NotchShape x:Name="Notch"
                              PillWidth="260" PillHeight="34" BottomRadius="17" Fillet="14"
                              HorizontalAlignment="Center" VerticalAlignment="Top"
                              Fill="#F2101010"
                              Stroke="{StaticResource PanelBorderBrush}" StrokeThickness="1">
                <views:NotchShape.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55" Color="Black"/>
                </views:NotchShape.Effect>
            </views:NotchShape>

            <!-- The runner-up activity, split off into a form of its own beside the pill.

                 A sibling of the silhouette rather than a child of the content host, because that
                 host clips: the bubble is outside the pill, which is the entire point of it. Being
                 inside the Pill grid still gets it the drop-in slide and the show/hide fade for
                 free, so there is only ever one of each animation to keep in step.

                 Placed from code (PlaceBubble) rather than by a margin: which side it sits on and
                 how far out depend on the island's shape and which end of the edge it is parked
                 at, and a margin on a centre-aligned element shifts it by half its value. -->
            <Grid x:Name="Bubble" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Opacity="0" RenderTransformOrigin="0,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <!-- Grows out of the edge facing the pill, so it reads as the island
                             splitting rather than as a notification appearing next to it. -->
                        <ScaleTransform x:Name="BubbleScale" ScaleX="0.3" ScaleY="0.3"/>
                        <TranslateTransform x:Name="BubbleSlide"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <views:NotchShape x:Name="BubbleShape"
                                  PillWidth="34" PillHeight="34" BottomRadius="17" Fillet="8"
                                  HorizontalAlignment="Center" VerticalAlignment="Top"
                                  Fill="#F2101010"
                                  Stroke="{StaticResource PanelBorderBrush}" StrokeThickness="1">
                    <views:NotchShape.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55" Color="Black"/>
                    </views:NotchShape.Effect>
                </views:NotchShape>

                <Border x:Name="BubbleContentHost" Width="34" Height="34"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Background="Transparent">
                    <ContentControl Content="{Binding Secondary}"
                                    ContentTemplateSelector="{StaticResource CompactActivity}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <Border x:Name="PillContent"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Width="260" Height="34"
                    Background="Transparent"
                    ClipToBounds="True">
                <Grid>
                    <!-- Collapsed: whichever activity currently holds the pill, at a glance. Its
                         DataContext is the activity host, set in the constructor; the form each
                         activity takes here is a DataTemplate up in Window.Resources. -->
                    <Grid x:Name="CollapsedLayer" Width="236" Height="22"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentControl Content="{Binding Primary}"/>

                        <!-- The idle peek: hovering the top edge with nothing playing still gets an
                             answer, rather than the island appearing to be broken.

                             The island's empty state rather than media's, which is why it sits out
                             here beside the ContentControl instead of inside a template: with no
                             activity there is no template being drawn to put it in. -->
                        <TextBlock Text="Nothing playing"
                                   Foreground="#77FFFFFF" FontSize="11.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Primary, Converter={StaticResource NullToVisibility}}"/>
                    </Grid>

                    <!-- Expanded: what is playing, whichever section is open, and the strip of tabs
                         that switches between them. Laid out at the expanded size from the start and
                         revealed by opacity, so the pill's growth does not reflow it. -->
                    <Grid x:Name="ExpandedLayer" Opacity="0" IsHitTestVisible="False"
                          Width="440" Margin="20,16,20,14"
                          HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- One row per showing activity that has something to say up here. Rows
                             rather than tabs: the tab strip is for sections a person navigates to,
                             and these are conditions, not places.

                             Generic on purpose. Every activity added from here on is a view model,
                             two templates and a registration: no surgery on this window, and no
                             renumbering the rows below every time. -->
                        <ItemsControl x:Name="ActivityRows"
                                      ItemsSource="{Binding Showing}"
                                      ItemTemplateSelector="{StaticResource ExpandedActivity}"/>

                        <!-- Shown only on the hover panel, and only with something playing. Driven
                             from code (UpdateMediaHeader) rather than bound, because it answers to
                             the open section as well as to the session. -->
                        <Grid x:Name="MediaHeader" Grid.Row="1" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="84" Height="84" CornerRadius="8" Margin="0,0,16,0"
                                    VerticalAlignment="Top" Background="#22FFFFFF">
                                <Border.OpacityMask>
                                    <VisualBrush>
                                        <VisualBrush.Visual>
                                            <Border Width="84" Height="84" CornerRadius="8" Background="White"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.OpacityMask>
                                <Image Source="{Binding Artwork, Converter={StaticResource PngToImage}}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding Title}" Foreground="White"
                                           FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="1" Text="{Binding Artist}" Foreground="#99FFFFFF"
                                           FontSize="11.5" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>

                                <Grid Grid.Row="2" Margin="0,12,0,0"
                                      Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding PositionText}" Style="{StaticResource TimeText}"
                                               Margin="0,0,8,0"/>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource IslandProgress}"
                                                 Value="{Binding Progress, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                               Style="{StaticResource TimeText}" Margin="8,0,0,0"/>
                                </Grid>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0"
                                            HorizontalAlignment="Center">
                                    <Button Style="{StaticResource TransportButton}" Content="&#xE892;"
                                            FontSize="13"
                                            Command="{Binding SkipPreviousCommand}"
                                            IsEnabled="{Binding CanSkipPrevious}"/>

                                    <Button Style="{StaticResource TransportButton}" FontSize="15"
                                            Margin="6,0" Command="{Binding PlayPauseCommand}">
                                        <Grid>
                                            <TextBlock Text="&#xE769;"
                                                       Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Text="&#xE768;"
                                                       Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource TransportButton}" Content="&#xE893;"
                                            FontSize="13"
                                            Command="{Binding SkipNextCommand}"
                                            IsEnabled="{Binding CanSkipNext}"/>
                                </StackPanel>

                                <!-- Fixed height rather than sized to content: SectionHost is
                                     unbounded for the Quick section (see SelectSection), so a
                                     ninety-line lyric sheet loaded in full would otherwise be free
                                     to grow the island straight off the bottom of the screen. -->
                                <ListBox x:Name="LyricsList" Grid.Row="4" Margin="0,10,0,0"
                                         Height="72" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                         Focusable="False" ItemsSource="{Binding Lyrics}"
                                         Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVisibility}}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Padding" Value="0,2"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" FontSize="12"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#66FFFFFF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>

                        <!-- One host, every section kept alive inside it: switching tabs hides and
                             shows rather than rebuilding, so a search box keeps its text and a list
                             its scroll position across a switch. -->
                        <!-- What is playing, for the sections that are not about it. The same
                             information as the block above and none of its furniture: no timeline,
                             no transport, no 84px of artwork. Thirty pixels instead of a hundred
                             and thirty, so a list still gets the panel.

                             It earns its place because the collapsed pill is not on screen while
                             the panel is open: without this, opening the Shelf loses the track
                             entirely. -->
                        <Grid x:Name="MediaStrip" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="20" Height="20" CornerRadius="4" Margin="0,0,9,0"
                                        Background="#22FFFFFF" VerticalAlignment="Center">
                                    <Border.OpacityMask>
                                        <VisualBrush>
                                            <VisualBrush.Visual>
                                                <Border Width="20" Height="20" CornerRadius="4"
                                                        Background="White"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Border.OpacityMask>
                                    <Image Source="{Binding Artwork, Converter={StaticResource PngToImage}}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="11.5"
                                           VerticalAlignment="Center" MaxWidth="330"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="{Binding Artist}" Foreground="#88FFFFFF" FontSize="11"
                                           VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="150"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Border Grid.Row="1" Height="1" Background="#22FFFFFF"/>
                        </Grid>

                        <Grid x:Name="SectionHost" Grid.Row="2" Margin="0,12,0,0">
                            <!-- The default, and what a hover shows: the scratchpad. -->
                            <Grid x:Name="QuickView">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Height="1" Background="#33FFFFFF"
                                        Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}"/>

                                <!-- Timer. Sits with the scratchpad because that is the part of the
                                     island you already come to in order to note something down and
                                     get on with it. Fixed lengths rather than a text box: picking
                                     a duration is a two-second decision and typing "25" then Enter
                                     is slower than pressing 25.

                                     Its own DataContext, a TimerActivity set from code-behind,
                                     since the rest of this layer is bound to the media view model. -->
                                <StackPanel x:Name="TimerPanel" Grid.Row="1" Orientation="Horizontal"
                                            Margin="0,10,0,0">
                                    <TextBlock Text="TIMER" Style="{StaticResource SectionHeaderText}"
                                               VerticalAlignment="Center" Margin="4,0,10,0"/>

                                    <Button Content="5m" Style="{StaticResource ChipButton}"
                                            Click="OnTimerClick" Tag="5"/>
                                    <Button Content="10m" Style="{StaticResource ChipButton}"
                                            Click="OnTimerClick" Tag="10"/>
                                    <Button Content="25m" Style="{StaticResource ChipButton}"
                                            Click="OnTimerClick" Tag="25"/>

                                    <Button Content="Stop" Style="{StaticResource ChipButton}"
                                            Click="OnTimerCancelClick"
                                            Visibility="{Binding IsActive,
                                                Converter={StaticResource BoolToVisibility}}"/>

                                    <TextBlock Text="{Binding RemainingText}" Foreground="White"
                                               FontSize="11.5" VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               Visibility="{Binding IsActive,
                                                   Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>

                                <Grid x:Name="TodosPanel" Grid.Row="2" Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <TextBlock Text="TODO" Style="{StaticResource SectionHeaderText}"/>
                                        <TextBlock Text="Clear done" Foreground="#99FFFFFF" FontSize="10"
                                                   HorizontalAlignment="Right" Cursor="Hand"
                                                   MouseLeftButtonUp="OnClearDoneClick"
                                                   Visibility="{Binding Todos.Count, Converter={StaticResource CountToVisibility}}"/>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <TextBlock Text="Add a task, press Enter..." Foreground="#55FFFFFF"
                                                   FontSize="11.5" IsHitTestVisible="False"
                                                   Visibility="{Binding DraftText.Length, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}"/>

                                        <TextBox x:Name="TodoInput" Style="{StaticResource NoteInput}"
                                                 Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <ItemsControl Grid.Row="2" Margin="0,6,0,0" ItemsSource="{Binding Todos}"
                                                  Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox IsChecked="{Binding IsDone}" Focusable="False"
                                                              VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                    <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                               Foreground="#DDFFFFFF" FontSize="11.5"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                        <Setter Property="Foreground" Value="#66FFFFFF"/>
                                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock Grid.Column="2" Text="&#xE711;"
                                                               FontFamily="{StaticResource GlyphFont}" FontSize="10"
                                                               Foreground="#66FFFFFF" Cursor="Hand"
                                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                                               ToolTip="Remove"
                                                               MouseLeftButtonUp="OnRemoveTodoClick"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <!-- Its own DataContext: a NotesViewModel, same reasoning. -->
                                <Grid x:Name="NotesPanel" Grid.Row="3" Margin="0,14,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="NOTES" Style="{StaticResource SectionHeaderText}"/>

                                    <!-- The stock TextBox has no watermark of its own: this is a second
                                         TextBlock sitting behind it, hidden the moment there is real text. -->
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <TextBlock Text="Add a note, press Enter..." Foreground="#55FFFFFF"
                                                   FontSize="11.5" IsHitTestVisible="False"
                                                   Visibility="{Binding DraftText.Length, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}"/>

                                        <TextBox x:Name="NoteInput" Style="{StaticResource NoteInput}"
                                                 Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <ItemsControl Grid.Row="2" Margin="0,6,0,0" ItemsSource="{Binding Notes}"
                                                  Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Text}" Foreground="#DDFFFFFF"
                                                               FontSize="11.5" TextTrimming="CharacterEllipsis"/>

                                                    <TextBlock Grid.Column="1" Style="{StaticResource TimeText}"
                                                               Margin="10,0,0,0"
                                                               Text="{Binding CreatedAt, StringFormat={}{0:h:mm tt}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>

                            <!-- The former taskbar panels, re-hosted. Their DataContext is the dock
                                 view model, set once from code-behind on this host's children. -->
                            <panels:ShelfPanel x:Name="ShelfView" Visibility="Collapsed"/>
                            <panels:ClipboardPanel x:Name="ClipboardView" Visibility="Collapsed"/>
                            <panels:LauncherPanel x:Name="LauncherView" Visibility="Collapsed"/>
                            <panels:RecentPanel x:Name="RecentView" Visibility="Collapsed"/>
                            <panels:StacksPanel x:Name="StacksView" Visibility="Collapsed"/>
                            <panels:MixerPanel x:Name="MixerView" Visibility="Collapsed"/>
                        </Grid>

                        <!-- The tab strip, and the app's only remaining chrome: everything that used
                             to be a taskbar button of its own is reached from here. -->
                        <Grid x:Name="TabStrip" Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="StatsText" Foreground="#66FFFFFF" FontSize="10"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ToggleButton x:Name="ShelfTab" Style="{StaticResource IslandTab}"
                                              Content="&#xE8B7;" ToolTip="Shelf"
                                              Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>
                                <ToggleButton x:Name="ClipboardTab" Style="{StaticResource IslandTab}"
                                              Content="&#xE8C8;" ToolTip="Clipboard history"
                                              Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>
                                <ToggleButton x:Name="LauncherTab" Style="{StaticResource IslandTab}"
                                              Content="&#xE721;" ToolTip="Search apps"
                                              Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>
                                <ToggleButton x:Name="RecentTab" Style="{StaticResource IslandTab}"
                                              Content="&#xE81C;" ToolTip="Recent files"
                                              Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>
                                <ToggleButton x:Name="StacksTab" Style="{StaticResource IslandTab}"
                                              Content="&#xE838;" ToolTip="Folder stacks"
                                              Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>
                                <ToggleButton x:Name="MixerTab" Style="{StaticResource IslandTab}"
                                              Content="&#xE767;" ToolTip="Volume mixer"
                                              Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>
                                <ToggleButton x:Name="NotesTab" Style="{StaticResource IslandTab}"
                                              Content="&#xE70B;" ToolTip="Notes and todo"
                                              Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>

                                <Border Width="1" Height="16" Background="#33FFFFFF" Margin="6,0"/>

                                <Button x:Name="SettingsButton" Style="{StaticResource IslandTabButton}"
                                        Content="&#xE713;" ToolTip="Settings"
                                        Click="OnSettingsClick"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
