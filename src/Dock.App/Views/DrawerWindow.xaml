<views:PanelWindow x:Class="Dock.App.Views.DrawerWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:views="clr-namespace:Dock.App.Views"
                   xmlns:panels="clr-namespace:Dock.App.Views.Panels"
                   Title="Dock Drawer"
                   Width="620" Height="520"
                   MinWidth="460" MinHeight="360"
                   WindowStyle="None"
                   AllowsTransparency="True"
                   ResizeMode="CanResize">
    <views:PanelWindow.Resources>
        <!-- The rail entries are ToggleButtons in a group so exactly one stays lit; the actual
             panel switching hangs off Checked rather than a selector control, because each panel
             is kept alive (and its scroll position, search text and open fan with it) rather than
             being rebuilt on every switch. -->
        <Style x:Key="RailButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Plate" Background="Transparent" CornerRadius="8" Margin="6,2">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="9" Margin="0,3,0,0"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </views:PanelWindow.Resources>

    <Border Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.ColumnSpan="2" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
                <TextBlock x:Name="StatsText" Foreground="#DDFFFFFF" FontSize="12" FontWeight="SemiBold"
                           Margin="18,12,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,18,0">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="#99FFFFFF" Cursor="Hand" Margin="0,0,12,0"
                               ToolTip="Settings"
                               MouseLeftButtonUp="OnSettingsClick"/>
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="#99FFFFFF" Cursor="Hand"
                               ToolTip="Put away"
                               MouseLeftButtonUp="OnMinimiseClick"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                <ToggleButton x:Name="RecentTab" Style="{StaticResource RailButton}" Content="Recent"
                              Tag="&#xE81C;" Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>
                <ToggleButton x:Name="StacksTab" Style="{StaticResource RailButton}" Content="Stacks"
                              Tag="&#xE8B7;" Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>
                <ToggleButton x:Name="ClipboardTab" Style="{StaticResource RailButton}" Content="Clipboard"
                              Tag="&#xE8C8;" Checked="OnTabChecked" Unchecked="OnTabUnchecked"/>
            </StackPanel>

            <Grid Grid.Row="1" Grid.Column="1">
                <panels:RecentPanel x:Name="RecentView"/>
                <panels:StacksPanel x:Name="StacksView" Visibility="Collapsed"/>
                <panels:ClipboardPanel x:Name="ClipboardView" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</views:PanelWindow>
