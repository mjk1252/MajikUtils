<UserControl x:Class="Dock.App.Views.NowPlayingBars"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Heights are animated from code-behind rather than by a storyboard so they run only while
         they can actually be seen: playing, on screen, and not covered by the expanded panel. The
         colour comes from the artwork, and is set there too.

         Centred rather than sat on a baseline, so a growing bar opens out from the middle in both
         directions instead of sprouting upwards. -->
    <StackPanel Orientation="Horizontal" Height="14" VerticalAlignment="Center">
        <Rectangle x:Name="Bar1" Width="2.5" Height="3" RadiusX="1.25" RadiusY="1.25"
                   Fill="#DDFFFFFF" VerticalAlignment="Center" Margin="0,0,2.5,0"/>
        <Rectangle x:Name="Bar2" Width="2.5" Height="3" RadiusX="1.25" RadiusY="1.25"
                   Fill="#DDFFFFFF" VerticalAlignment="Center" Margin="0,0,2.5,0"/>
        <Rectangle x:Name="Bar3" Width="2.5" Height="3" RadiusX="1.25" RadiusY="1.25"
                   Fill="#DDFFFFFF" VerticalAlignment="Center" Margin="0,0,2.5,0"/>
        <Rectangle x:Name="Bar4" Width="2.5" Height="3" RadiusX="1.25" RadiusY="1.25"
                   Fill="#DDFFFFFF" VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
