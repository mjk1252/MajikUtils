<UserControl x:Class="Dock.App.Views.Panels.StacksPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="OnDrop"
             Background="Transparent"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="STACKS -- click a folder to fan it open" Style="{StaticResource SectionHeaderText}"/>
            <TextBlock Text="Add folder..." Foreground="#99FFFFFF" FontSize="10"
                       HorizontalAlignment="Right" Cursor="Hand"
                       MouseLeftButtonUp="OnAddFolderClick"/>
        </Grid>

        <TextBlock Grid.Row="1" Style="{StaticResource EmptyStateText}"
                   Text="No stacks yet -- use Add folder, or drag a folder onto this panel."
                   Visibility="{Binding Stacks.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Stacks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="76" Height="76" Margin="4"
                                CornerRadius="10" Background="Transparent"
                                Cursor="Hand"
                                ToolTip="{Binding Name}"
                                MouseLeftButtonUp="OnStackTileClick"
                                MouseRightButtonUp="OnStackTileRightClick">
                            <Grid>
                                <Border CornerRadius="10" Background="#4D000000"
                                        Visibility="{Binding IconPng, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="{Binding Name, Converter={StaticResource NameToInitial}}"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                                       Width="44" Height="44" VerticalAlignment="Top" Margin="0,6,0,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding Name}" Foreground="#DDFFFFFF" FontSize="10"
                                           VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                           MaxWidth="72" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Popup x:Name="StackFanFlyout"
               Placement="Top"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Canvas x:Name="StackFanCanvas" Width="780" Height="780" IsHitTestVisible="True">
                <ItemsControl x:Name="StackFanItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding FanOffsetX}"/>
                            <Setter Property="Canvas.Top" Value="{Binding FanOffsetY}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Fixed size because the fan's geometry is computed from it: see the
                                 FanItemHalfWidth/FanItemHalfHeight constants in StacksPanel.xaml.cs,
                                 which must stay in step with these numbers. -->
                            <Grid Width="108" Height="86" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="OnFanEntryMouseDown"
                                  MouseLeftButtonUp="OnFanEntryClick"
                                  MouseMove="OnFanEntryMouseMove">
                                <!-- No plate or border behind the icon: the shell icon carries its
                                     own silhouette, and chrome around it only shrank the artwork. -->
                                <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                                       Width="72" Height="72"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Effect>
                                        <!-- Keeps light icons from dissolving into a light desktop
                                             now that there is no plate behind them. -->
                                        <DropShadowEffect Color="Black" BlurRadius="8"
                                                          ShadowDepth="1" Direction="270"
                                                          Opacity="0.55"/>
                                    </Image.Effect>
                                </Image>

                                <!-- The name overlays the icon's lower edge. Legibility over
                                     arbitrary icon artwork comes from an opaque rounded plate
                                     rather than a text outline, which is the only treatment that
                                     holds up against both light and dark icons underneath. -->
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                        MaxWidth="108" CornerRadius="7" Padding="6,2"
                                        Background="#D9101010" BorderBrush="#33FFFFFF"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="6"
                                                          ShadowDepth="0" Opacity="0.7"/>
                                    </Border.Effect>
                                    <!-- Wraps to at most two lines (MaxHeight = 2 * LineHeight)
                                         before ellipsizing, so longer names stay readable without
                                         letting one entry grow unboundedly tall and collide with
                                         the next step of the fan. -->
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                               Foreground="White" FontSize="11"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                               MaxHeight="28" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Popup>
    </Grid>
</UserControl>
