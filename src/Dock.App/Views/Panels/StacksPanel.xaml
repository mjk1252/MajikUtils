<UserControl x:Class="Dock.App.Views.Panels.StacksPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="OnDrop"
             Background="Transparent">
    <!-- No margin of its own: SectionHost supplies the one gutter, shared by every panel. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="STACKS" Style="{StaticResource SectionHeaderText}"/>
            <Border Style="{StaticResource InlineActionHost}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    MouseLeftButtonUp="OnAddFolderClick">
                <TextBlock Text="Add folder..." Style="{StaticResource InlineAction}"/>
            </Border>
        </Grid>

        <!-- How stacks work belongs with the empty state and nowhere else: it is worth two lines
             of a small panel exactly once, before the feature has been used. -->
        <TextBlock Grid.Row="1" Style="{StaticResource EmptyStateText}"
                   Text="No stacks yet -- use Add folder, or drag a folder onto this panel. Each stack gets its own taskbar button: click it to fan the folder open, or right-click and choose Pin to taskbar to keep it there."
                   Visibility="{Binding Stacks.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding Stacks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}" Cursor="Arrow"
                                MouseRightButtonUp="OnStackRightClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                                       Width="24" Height="24" Margin="0,0,10,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="White"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Path}" Foreground="#66FFFFFF" FontSize="10"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource InlineActionHost}"
                                        VerticalAlignment="Center" Margin="8,0,0,0"
                                        MouseLeftButtonUp="OnRemoveClick">
                                    <TextBlock Text="Remove" Style="{StaticResource InlineAction}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
