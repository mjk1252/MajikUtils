<UserControl x:Class="Dock.App.Views.Panels.SearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The command palette's results, re-hosted in the island.
         No box of its own: the island's capture box is the box now, which is the entire point of
         the merge. This is only the list, and the keyboard that drives it. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource EmptyStateText}"
                   Text="Nothing matches. Searches apps, folder stacks, recent files and clipboard history."
                   Visibility="{Binding Results.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}"/>

        <ListBox x:Name="ResultsList" Grid.Row="1" MaxHeight="300"
                 Background="Transparent" BorderThickness="0"
                 Focusable="False"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemsSource="{Binding Results}"
                 Visibility="{Binding Results.Count, Converter={StaticResource CountToVisibility}}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,7"/>
                    <Setter Property="Margin" Value="0,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                    <!-- The caret never leaves the capture box, so the row cannot take focus
                         either: selection here is something the box's arrow keys move, not
                         somewhere the user tabs to. -->
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Plate" Background="Transparent" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Plate" Property="Background" Value="#18FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Plate" Property="Background"
                                                Value="{DynamicResource IslandAccentSoftBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MouseLeftButtonUp="OnResultClicked" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="24" Height="24" CornerRadius="5" Margin="0,0,10,0"
                                Background="#22FFFFFF"
                                Visibility="{Binding IconPng, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}">
                            <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                   Style="{StaticResource IslandBodyText}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2" Text="{Binding Category}"
                                   Style="{StaticResource IslandFaintText}" FontSize="10"
                                   VerticalAlignment="Center" Margin="12,0,2,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
