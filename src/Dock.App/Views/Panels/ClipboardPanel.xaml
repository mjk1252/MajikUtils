<UserControl x:Class="Dock.App.Views.Panels.ClipboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- The pin. Faint until the row is hovered, solid once the entry is actually pinned:
             an always-visible control on every row would be a column of furniture down a list
             whose whole job is to be read quickly. -->
        <Style x:Key="PinButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontFamily" Value="{StaticResource GlyphFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Plate" Background="Transparent" CornerRadius="6">
                            <TextBlock x:Name="Glyph" Text="&#xE718;"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <!-- Filled rather than outlined, so a pinned row reads as pinned
                                     from across the list without a legend. -->
                                <Setter TargetName="Glyph" Property="Text" Value="&#xE840;"/>
                                <Setter Property="Foreground" Value="{DynamicResource IslandAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Hovering anywhere on the row brings it out; a pinned one never hides. -->
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                             Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- No margin of its own: SectionHost supplies the one gutter, shared by every panel. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="CLIPBOARD HISTORY" Style="{StaticResource SectionHeaderText}"/>
            <Border Style="{StaticResource InlineActionHost}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    ToolTip="Clears everything except pinned entries"
                    MouseLeftButtonUp="OnClearClick"
                    Visibility="{Binding ClipboardHistory.Count, Converter={StaticResource CountToVisibility}}">
                <TextBlock Text="Clear" Style="{StaticResource InlineAction}"/>
            </Border>
        </Grid>

        <!-- Same rule-under-the-box as the capture field, so the two inputs in this app look like
             the same input. -->
        <Border Grid.Row="1" BorderThickness="0,0,0,1" Padding="2,0,2,6" Margin="0,0,0,8"
                Visibility="{Binding ClipboardHistory.Count, Converter={StaticResource CountToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource IslandAccentBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <TextBlock Text="Search what you have copied"
                           Style="{StaticResource IslandFaintText}" FontSize="12"
                           IsHitTestVisible="False" VerticalAlignment="Center"
                           Visibility="{Binding Text.Length, ElementName=SearchBox,
                               Converter={StaticResource CountToVisibility}, ConverterParameter=invert}"/>

                <TextBox x:Name="SearchBox" Style="{StaticResource CaptureText}" FontSize="12"
                         TextChanged="OnSearchChanged"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Style="{StaticResource EmptyStateText}"
                   Text="Nothing copied yet - press Ctrl+Alt+Shift+V anytime to reopen this list."
                   Visibility="{Binding ClipboardHistory.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}"/>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ClipboardResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- One row template with three bodies rather than a template selector.
                             The three are the same row - same plate, same hover, same click - and
                             differ only in what fills it, so a selector would be three copies of
                             the chrome to keep in agreement for the sake of avoiding two
                             collapsed elements. -->
                        <Border Style="{StaticResource ListRow}" Padding="8,7"
                                MouseLeftButtonDown="OnRowMouseDown"
                                MouseLeftButtonUp="OnItemClick"
                                MouseMove="OnRowMouseMove">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- TEXT -->
                                <TextBlock Text="{Binding Preview}"
                                           Style="{StaticResource IslandBodyText}" FontSize="12"
                                           TextWrapping="Wrap" MaxHeight="52"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}"/>

                                <!-- IMAGE. The thumbnail is the preview: a row that said
                                     "Image 1920 x 1080" would make you click every screenshot in
                                     the list to find the one you meant. -->
                                <Grid Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border CornerRadius="4" MaxWidth="96" MaxHeight="54"
                                            Background="#22FFFFFF" ClipToBounds="True"
                                            VerticalAlignment="Center">
                                        <Image Source="{Binding ImagePng, Converter={StaticResource PngToImage}}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding Preview}"
                                               Style="{StaticResource IslandMetaText}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>

                                <!-- FILES -->
                                <Grid Visibility="{Binding IsFiles, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ItemsControl ItemsSource="{Binding Files}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Collapsed rather than left blank when the
                                                         shell gave us nothing: an empty 16px box
                                                         reads as an icon that failed to load. -->
                                                    <Border Width="16" Height="16" Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IconPng,
                                                                Converter={StaticResource NullToVisibility},
                                                                ConverterParameter=invert}">
                                                        <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                               Style="{StaticResource IslandBodyText}"
                                                               FontSize="12" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Row="1" Margin="24,2,0,0"
                                               Style="{StaticResource IslandFaintText}" FontSize="10"
                                               Text="{Binding ExtraFileCount, StringFormat={}+{0} more}"
                                               Visibility="{Binding ExtraFileCount,
                                                   Converter={StaticResource CountToVisibility}}"/>
                                </Grid>

                                <ToggleButton Grid.Column="1" Style="{StaticResource PinButton}"
                                              VerticalAlignment="Top" Margin="6,0,0,0"
                                              ToolTip="Keep this entry"
                                              IsChecked="{Binding IsPinned}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
