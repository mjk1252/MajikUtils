<UserControl x:Class="Dock.App.Views.Panels.ShelfPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No margin of its own: SectionHost supplies the one gutter, shared by every panel. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="SHELF -- drop files here" Style="{StaticResource SectionHeaderText}"/>

        <!-- Highlights while a drag is over the island, so it reads as a target rather than just a
             list that happens to be showing. -->
        <Border x:Name="DropHint" Grid.Row="1" Grid.RowSpan="2"
                CornerRadius="8" BorderThickness="1" BorderBrush="Transparent"
                Background="Transparent" IsHitTestVisible="False" Panel.ZIndex="1"/>

        <TextBlock Grid.Row="1" Style="{StaticResource EmptyStateText}"
                   Text="Drag files onto the island to hold them here, then drag them back out wherever you need them."
                   Visibility="{Binding ShelfItems.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ShelfItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}"
                                MouseLeftButtonDown="OnRowMouseDown"
                                MouseLeftButtonUp="OnRowClick"
                                MouseMove="OnRowMouseMove"
                                MouseRightButtonUp="OnRowRightClick">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                                       Width="20" Height="20" Margin="0,0,10,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
