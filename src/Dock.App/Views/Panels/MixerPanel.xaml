<UserControl x:Class="Dock.App.Views.Panels.MixerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <FontFamily x:Key="GlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- A thin rule with a round thumb, in the same voice as the now-playing progress bar.
             The stock slider brings a chunky Windows-forms-era thumb and a focus rectangle that
             read as a form control dropped onto a HUD. -->
        <Style x:Key="MixerSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="SmallChange" Value="0.05"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="16" VerticalAlignment="Center">
                            <Border Height="4" Background="#2EFFFFFF" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4" Background="#E6FFFFFF" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent"
                                                  BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="White"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MuteButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontFamily" Value="{StaticResource GlyphFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="Transparent" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- No margin of its own: SectionHost supplies the one gutter, shared by every panel. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="MIXER" Style="{StaticResource SectionHeaderText}"/>

        <TextBlock Grid.Row="1" Style="{StaticResource EmptyStateText}"
                   Text="Nothing is making sound right now -- anything with an open audio session will show up here."
                   Visibility="{Binding Sessions.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="24" Height="24" CornerRadius="5" Margin="0,0,10,0"
                                    Background="#22FFFFFF" VerticalAlignment="Center">
                                <!-- Rounds the icon itself, not just the plate behind it: a Border's
                                     corner radius does not clip its child. Same mask as the artwork
                                     plates on the island. -->
                                <Border.OpacityMask>
                                    <VisualBrush>
                                        <VisualBrush.Visual>
                                            <Border Width="24" Height="24" CornerRadius="5" Background="White"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.OpacityMask>
                                <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,12,4"/>

                                <Slider Grid.Row="1" Style="{StaticResource MixerSlider}"
                                        Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,12,0"/>
                            </Grid>

                            <Button Grid.Column="2" Style="{StaticResource MuteButton}"
                                    Command="{Binding ToggleMuteCommand}"
                                    ToolTip="Mute / unmute">
                                <Grid>
                                    <TextBlock Text="&#xE767;"
                                               Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                    <TextBlock Text="&#xE74F;" Foreground="#FF9F0A"
                                               Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
