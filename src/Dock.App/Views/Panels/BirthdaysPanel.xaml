<UserControl x:Class="Dock.App.Views.Panels.BirthdaysPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- No margin of its own: SectionHost supplies the one gutter, shared by every panel. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="BIRTHDAYS -- soonest first" Style="{StaticResource SectionHeaderText}"/>

            <!-- The list is a file, and this is the only signpost to that fact. Without it the
                 panel is a read-only list with no visible way to add anybody to it. -->
            <Border Style="{StaticResource InlineActionHost}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0"
                    ToolTip="Opens birthdays.csv in whatever you edit CSVs with"
                    MouseLeftButtonUp="OnEditClick">
                <TextBlock Text="Edit list..." Style="{StaticResource InlineAction}"/>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Upcoming}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,0,4,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- The gutter carries a cake on the day and a dot every other day,
                                     so the rows share a text baseline rather than stepping where
                                     the marker changes, the same arrangement the notes list uses
                                     for its two kinds of row. -->
                                <TextBlock Text="&#x1F382;" FontSize="12"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Visibility="{Binding IsToday,
                                               Converter={StaticResource BoolToVisibility}}"/>

                                <Ellipse Width="4" Height="4" Margin="4,0,0,0"
                                         Fill="{DynamicResource TextTertiaryBrush}"
                                         VerticalAlignment="Center" HorizontalAlignment="Left"
                                         Visibility="{Binding IsToday,
                                             Converter={StaticResource BoolToVisibility},
                                             ConverterParameter=invert}"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" MaxWidth="200"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource IslandBodyText}">
                                                <Style.Triggers>
                                                    <!-- Today's name carries the weight. It is the
                                                         one row anybody opened this to see. -->
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{Binding AgeText}" Margin="8,0,0,0"
                                               Style="{StaticResource IslandFaintText}"
                                               FontSize="10" VerticalAlignment="Center"
                                               Visibility="{Binding HasAge,
                                                   Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DateText}"
                                               Style="{StaticResource IslandFaintText}"
                                               FontSize="10" VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <!-- The countdown, which is the column the list is sorted by
                                         and so the one worth reading down. -->
                                    <TextBlock Text="{Binding CountdownText}"
                                               VerticalAlignment="Center" MinWidth="66"
                                               TextAlignment="Right"
                                               Typography.NumeralAlignment="Tabular">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource IslandMetaText}">
                                                <Setter Property="FontSize" Value="10.5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource IslandAccentBrush}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- An empty list and a list that has not loaded look identical, and mean opposite
                     things. This says which it is, and says what to do about it. -->
                <TextBlock Style="{StaticResource EmptyStateText}"
                           Text="No birthdays yet. Choose Edit list... above to open birthdays.csv -- one person per line, as name,date."
                           Visibility="{Binding IsEmpty,
                               Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
