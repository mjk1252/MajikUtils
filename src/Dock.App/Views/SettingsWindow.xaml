<Window x:Class="Dock.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MajikUtils Settings"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E">
    <StackPanel Margin="24">
        <TextBlock Text="MajikUtils Settings" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>

        <TextBlock Foreground="#99FFFFFF" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="MajikUtils lives in the island at the top of your screen: point at it for the shelf, clipboard, app search, recent files, notes and todo. Folder stacks keep their own taskbar buttons -- right-click one and choose Pin to taskbar to keep it there."/>

        <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start MajikUtils automatically when Windows starts"
                  Foreground="White" Margin="0,0,0,16"
                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

        <CheckBox x:Name="MediaIslandCheckBox" Content="Show what's playing in the island"
                  Foreground="White" Margin="0,0,0,4"
                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

        <TextBlock Foreground="#77FFFFFF" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,10"
                   Text="Shows the current track on the collapsed island and playback controls when you point at it. Turning this off leaves the island with everything else -- it stays hidden until you touch the top edge of the screen."/>

        <CheckBox x:Name="PrivacyIndicatorCheckBox" Content="Show when an app is using the camera"
                  Foreground="White" Margin="0,0,0,4"
                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

        <TextBlock Foreground="#77FFFFFF" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,10"
                   Text="Puts a green dot on the island naming whichever app has the camera on. The microphone is deliberately left out: apps hold it open the whole time they are running, so that light would never go off. Windows reports this itself, so an app reaching the camera another way may not appear."/>

        <Grid Margin="24,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#99FFFFFF"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,0,10,0"/>
                </Style>
                <Style TargetType="ComboBox">
                    <Setter Property="Margin" Value="0,0,0,6"/>
                </Style>
            </Grid.Resources>

            <TextBlock Text="Shape"/>
            <ComboBox x:Name="IslandShapeCombo" Grid.Column="1" SelectionChanged="OnComboChanged">
                <ComboBoxItem Content="Notch (joined to the screen edge)"/>
                <ComboBoxItem Content="Pill (floating below the edge)"/>
            </ComboBox>

            <TextBlock Grid.Row="1" Text="Position"/>
            <ComboBox x:Name="IslandAlignmentCombo" Grid.Row="1" Grid.Column="1"
                      SelectionChanged="OnComboChanged">
                <ComboBoxItem Content="Top left"/>
                <ComboBoxItem Content="Top centre"/>
                <ComboBoxItem Content="Top right"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Text="Monitor"/>
            <ComboBox x:Name="IslandMonitorCombo" Grid.Row="2" Grid.Column="1"
                      DisplayMemberPath="Label" SelectionChanged="OnComboChanged"/>
        </Grid>

        <TextBlock Foreground="#77FFFFFF" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Clipboard history is captured in the background. Press Ctrl+Alt+Shift+V anywhere to open the drawer on its Clipboard tab."/>

        <Button Content="Close" Width="80" HorizontalAlignment="Right" Padding="0,4" Click="OnCloseClick"/>
    </StackPanel>
</Window>
