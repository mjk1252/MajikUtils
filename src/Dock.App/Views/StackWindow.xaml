<views:PanelWindow x:Class="Dock.App.Views.StackWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:views="clr-namespace:Dock.App.Views"
                   WindowStyle="None"
                   AllowsTransparency="True"
                   ResizeMode="CanMinimize">
    <!-- The window is one big invisible rectangle: a transparent WPF window is still hit-testable
         across its whole area, so clicks in the gaps between fan tiles land here rather than on
         the desktop underneath. OnBackdropMouseDown turns those into a dismiss, which is what
         clicking away from a flyout means anyway. -->
    <Canvas x:Name="FanCanvas" Background="Transparent" MouseLeftButtonDown="OnBackdropMouseDown">
        <ItemsControl x:Name="FanItems">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding FanOffsetX}"/>
                    <Setter Property="Canvas.Top" Value="{Binding FanOffsetY}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Fixed size because the fan's geometry is computed from it: see the
                         FanItemHalfWidth/FanItemHalfHeight constants in StackWindow.xaml.cs,
                         which must stay in step with these numbers. -->
                    <Grid Width="108" Height="86" Background="Transparent" Cursor="Hand"
                          MouseLeftButtonDown="OnEntryMouseDown"
                          MouseLeftButtonUp="OnEntryClick"
                          MouseMove="OnEntryMouseMove">
                        <!-- No plate or border behind the icon: the shell icon carries its own
                             silhouette, and chrome around it only shrank the artwork. -->
                        <Image Source="{Binding IconPng, Converter={StaticResource PngToImage}}"
                               Width="72" Height="72"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <!-- Keeps light icons from dissolving into a light desktop now
                                     that there is no plate behind them. -->
                                <DropShadowEffect Color="Black" BlurRadius="8"
                                                  ShadowDepth="1" Direction="270"
                                                  Opacity="0.55"/>
                            </Image.Effect>
                        </Image>

                        <!-- The name overlays the icon's lower edge. Legibility over arbitrary
                             icon artwork comes from an opaque rounded plate rather than a text
                             outline, which is the only treatment that holds up against both light
                             and dark icons underneath. -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                MaxWidth="108" CornerRadius="7" Padding="6,2"
                                Background="#D9101010" BorderBrush="#33FFFFFF"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="6"
                                                  ShadowDepth="0" Opacity="0.7"/>
                            </Border.Effect>
                            <!-- Wraps to at most two lines (MaxHeight = 2 * LineHeight) before
                                 ellipsizing, so longer names stay readable without letting one
                                 entry grow unboundedly tall and collide with the next step. -->
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                       Foreground="White" FontSize="11"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                       MaxHeight="28" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Canvas>
</views:PanelWindow>
