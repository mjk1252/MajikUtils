<Application x:Class="Dock.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dock.App"
             xmlns:conv="clr-namespace:Dock.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Application-scoped rather than per-window: the panels are UserControls hosted by two
             different windows, and a resource declared on one window is invisible to the other. -->
        <conv:PngBytesToImageSourceConverter x:Key="PngToImage"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:NameToInitialConverter x:Key="NameToInitial"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:CountToVisibilityConverter x:Key="CountToVisibility"/>
        <conv:ProgressToArcConverter x:Key="ProgressToArc"/>

        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F21C1C1C"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#26FFFFFF"/>

        <!-- The text ramp, and the whole of it. Three levels, not the six the island had grown:
             hierarchy on a dark HUD is carried by *few* clearly separated steps, and a ramp with
             #77, #88 and #99 in it is three ways of saying the same thing that read as one.

             These three and IslandSurfaceBrush below are what the theme in Settings writes, and
             what is declared here is only the seed: Theme.Apply replaces each entry outright at
             startup and again whenever the colours change. That is why every reference to these
             four keys is a DynamicResource. A StaticResource resolves once when the BAML loads and
             would spend the rest of the session holding the white one it started with, which is
             exactly the bug the accent brushes were built around, and the same fix. -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#61FFFFFF"/>

        <!-- The island's own background, and the one thing the two chosen gradient colours paint.
             Seeded flat here at the near-black the island has always been, so an install that has
             never opened the theme settings looks exactly as it did. -->
        <SolidColorBrush x:Key="IslandSurfaceBrush" Color="#F2101010"/>

        <!-- Taken from the artwork of whatever is playing and pushed here by the island, so a
             brush declared once is the single place every accented thing reads from: the progress
             fill, the lit scope, a focused input's rule. Mutated in place rather than replaced -
             StaticResource holds the instance, and Color is a dependency property, so every
             reference repaints without any of them having to be dynamic.

             Also why it is application-scoped: the section panels are UserControls in their own
             files and cannot see a brush declared on the island's window. -->
        <!-- IslandAccentBrush and IslandAccentSoftBrush are NOT declared here, and cannot be.
             WPF freezes what it can when it loads a resource dictionary from BAML, and a frozen
             brush can neither be recoloured nor animated - which is the only thing these two
             exist to do. Declared in XAML they came out frozen and every repaint was silently
             discarded. App.InstallAccentBrushes creates them instead; see there for the seeds. -->

        <!-- Three text roles. Everything in the island is one of these or it is a mistake:
             a title, a line of content, or a label about the content. -->
        <Style x:Key="IslandTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="IslandBodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="IslandMetaText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="IslandFaintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Glyphs come from the shell's own icon font, with the Windows 10 name as a fallback. -->
        <FontFamily x:Key="GlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Caret and selection are the only chrome a stock TextBox brings that still belongs here;
             everything else reads as a form field dropped onto a HUD. -->
        <Style x:Key="CaptureText" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>

        <Style x:Key="EmptyStateText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="4,0,4,4"/>
        </Style>

        <!-- Hover feedback for the list rows in every panel. The rows are Borders with click
             handlers rather than Buttons (they carry drag gestures and context menus), so the
             highlight has to come from a style trigger instead of a control template. -->
        <Style x:Key="ListRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#18FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A small labelled action inside a panel, as opposed to the icon-only tabs below.
             Application-scoped for the same reason as the rest of this dictionary: the panel
             UserControls need it as much as the island window does. -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="#16FFFFFF" CornerRadius="9"
                                Padding="9,3" BorderThickness="1"
                                BorderBrush="{StaticResource PanelBorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#2EFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The stock checkbox brings a light-themed box, a system accent tick and a focus
             rectangle: three things that read as a form control on a dark HUD. This is the same
             rounded-square vocabulary as the icon plates, with the tick drawn from the shell's
             glyph font. -->
        <Style x:Key="IslandCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="14" Height="14" CornerRadius="4"
                                Background="Transparent" BorderThickness="1"
                                BorderBrush="#55FFFFFF">
                            <TextBlock x:Name="Tick" Text="&#xE73E;"
                                       FontFamily="{StaticResource GlyphFont}" FontSize="9"
                                       Foreground="#FF101010" Opacity="0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E6FFFFFF"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#E6FFFFFF"/>
                                <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#99FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The small text actions in a panel header ("Clear", "Add folder...", the row's remove
             glyph). They carry click handlers rather than being Buttons, so the affordance has to
             come from a wrapper: InlineActionHost is the hit box and the hover, InlineAction the
             label inside it. Same hover value as the tab strip. -->
        <Style x:Key="InlineActionHost" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#18FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InlineAction" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
