<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Follows Dock.Interop onto a Windows-versioned TFM: a project cannot reference one that
         targets a higher platform version than its own. -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Regenerate with tools/make-icon.ps1 after changing assets/icon-source.png. -->
    <ApplicationIcon>..\..\assets\MajikUtils.ico</ApplicationIcon>
    <AssemblyName>MajikUtils</AssemblyName>
    <RootNamespace>Dock.App</RootNamespace>
    <!-- The one place the version lives at build time. Settings reads it back off the assembly
         for a dev build; an installed copy shows Velopack's own CurrentVersion instead, which is
         independent of this and set by build-velopack-release.ps1's -Version at pack time (that
         script defaults -Version to this line). installer/MajikUtils.iss's AppVersion is still
         bumped separately alongside both. -->
    <Version>2.3.3</Version>
    <!-- Program.Main has to run before WPF's own generated one would, so Velopack sees a launch
         carrying its install/update/uninstall flags before anything else does. -->
    <StartupObject>Dock.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- App.xaml stops being an ApplicationDefinition (which is what generates the competing
         Main WPF's SDK would otherwise emit) and becomes a plain Page; Program.cs calls
         InitializeComponent on it by hand instead. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied rather than embedded so the shipped icons can be swapped in place, and so the
         shell can point a pinned button's RelaunchIconResource at a real file on disk. -->
    <Content Include="..\..\assets\icons\**\*.*" LinkBase="assets\icons" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dock.Core\Dock.Core.csproj" />
    <ProjectReference Include="..\Dock.Interop\Dock.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
